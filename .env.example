# 复制为 .env 并修改。Docker 部署时 docker-compose 会通过 env_file 把整个 .env 注入容器。

# ===== 必填 =====
# session 签名密钥，至少 32 个字符，用 `openssl rand -hex 32` 生成，缺失或太短服务会拒绝启动
SESSION_SECRET=请改成一串随机字符串
PORT=3000

# ===== HTTPS 相关 =====
# 服务器确认已经配好 HTTPS 之后，把下面这行打开（改成 true），
# 否则 session cookie 不会带 secure 标记，浏览器该拦截的攻击拦不住
COOKIE_SECURE=false

# 如果部署在 Nginx/Caddy 等反向代理后面（由代理终止 HTTPS、转发给 Node），设为 1
TRUST_PROXY=0

# ===== 阿里云短信（官网试用注册的验证码，不配则试用注册不可用）=====
# 建议使用 RAM 子账号的 AccessKey，只授予 AliyunDysmsFullAccess（或仅 SendSms）权限
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 短信签名（需在阿里云控制台审核通过，例如：鸭鸭进销存）
ALIYUN_SMS_SIGN_NAME=
# 验证码模板 Code（形如 SMS_123456789，模板内容需包含 ${code} 变量）
ALIYUN_SMS_TEMPLATE_CODE=

# ===== 新试用开通的通知渠道（可选，不配只影响你收不到通知，不影响用户开通）=====
# 飞书群自定义机器人 Webhook
FEISHU_WEBHOOK_URL=
# 邮件通知：SMTP 发信配置 + 收件邮箱
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
