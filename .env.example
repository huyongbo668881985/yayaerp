# 复制为 .env 并修改。Docker 部署时 docker-compose 会通过 env_file 把整个 .env 注入容器。

# ===== 必填 =====
# session 签名密钥，至少 32 个字符，用 `openssl rand -hex 32` 生成，缺失或太短服务会拒绝启动
SESSION_SECRET=请改成一串随机字符串
PORT=3000

# ===== HTTPS 相关 =====
# 服务器确认已经配好 HTTPS 之后，把下面这行打开（改成 true），
# 否则 session cookie 不会带 secure 标记，浏览器该拦截的攻击拦不住
COOKIE_SECURE=false

# 如果部署在 Nginx/Caddy 等反向代理后面（由代理终止 HTTPS、转发给 Node），设为 1
TRUST_PROXY=0

# ===== 阿里云「短信认证服务」（官网试用注册的验证码，不配则试用注册不可用）=====
# 产品线说明：用的是「短信认证服务」（dypnsapi），不是传统「短信服务(dysmsapi)」。
# 签名/模板用阿里云赠送的，无需自己申请审核。赠送值全账号通用（2026-09-06 实测）：
#   签名：恒创联众    模板：100001（内容含 ${code} 和 ${min} 变量）
# 如有变动可在控制台查询：
#   https://dypns.console.aliyun.com/smsCertParamsConfig/sign
#   https://dypns.console.aliyun.com/smsCertParamsConfig/template
# 建议使用 RAM 子账号的 AccessKey
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
# 模板变量占位符：##code## 由系统生成真实验证码后替换；min 与 5 分钟有效期对应。
# 如果赠送模板调整导致变量变化，按实际内容修改此 JSON
#ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# ===== 数据备份（手动/ cron 运行 node scripts/backup-run.js 时生效）=====
# 备份输出目录，默认 data/backups（Docker volume 内，随 data 一起持久化），一般不用改
#BACKUP_DIR=
# 本地快照保留天数：保留 [今天-N天, 今天]，默认 7，早于 今天-N天 的快照自动删除
#BACKUP_RETENTION_DAYS=7
# 快照加密密钥（必填，否则备份任务拒绝运行）：用 `openssl rand -hex 32` 生成。
# 【非常重要】密钥丢失则所有备份永久无法解密，请把它妥善保管在密码管理器/离线介质里。
# 解密/恢复方法见 docs/BACKUP.md。
BACKUP_ENCRYPTION_KEY=

# ===== Cloudflare R2 异地同步（可选，四项全配才启用；不配则只做本地备份）=====
# 创建入口：Cloudflare 控制台 -> R2 -> Manage API Tokens（需要 Object Read & Write 权限）
# R2 端 7 天自动过期靠 bucket 的 Lifecycle Rule 配置，见 docs/BACKUP.md 第 5 节
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# bucket 内的前缀（目录），可留空表示存到 bucket 根；如 backups
#R2_PREFIX=backups
# rclone 命令路径（默认用 PATH 里的 rclone）；容器内已随镜像安装
#RCLONE_PATH=rclone

# ===== 备份失败告警邮箱（可选，rclone 同步失败/快照失败时发信；SMTP 复用上面的配置）=====
BACKUP_ALERT_EMAIL=

# ===== 新试用开通的通知渠道（可选，不配只影响你收不到通知，不影响用户开通）=====
# 飞书群自定义机器人 Webhook
FEISHU_WEBHOOK_URL=
# 邮件通知：SMTP 发信配置 + 收件邮箱
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
