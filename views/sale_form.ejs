<%- include('partials/header') %>
<% const form = typeof formValues !== 'undefined' && formValues ? formValues : (order || {}); %>
<div class="page-heading-actions"><h1><%= order ? '编辑销售单 #' + order.id : '新建销售单' %></h1><a class="sale-cancel-link" href="<%= order ? '/sales/' + order.id : (form.customer_id ? '/sales?customer_id=' + form.customer_id : '/sales') %>">返回</a></div>
<div class="card sale-form-card">
  <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
  <% if (order) { %><p class="muted">编辑后仍是草稿状态，保存后需要重新点"提交审核"。</p><% } %>
  <form method="POST" action="<%= order ? '/sales/' + order.id + '/edit' : '/sales/new' %>" id="saleForm">
    <h2 class="form-section-heading">基本信息</h2>
    <div class="grid-3">
      <div class="form-row customer-picker-field">
        <label>客户（可选）</label>
        <div class="customer-picker" id="customerPicker">
          <div class="customer-picker-control">
            <span class="customer-picker-icon" aria-hidden="true">⌕</span>
            <input id="customerSearch" class="customer-picker-search" type="search" placeholder="搜索名称、联系人、电话或地址" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="customerPickerResults" aria-autocomplete="list">
            <button type="button" id="clearCustomer" class="customer-picker-clear" aria-label="清除已选客户" hidden>×</button>
          </div>
          <div id="customerPickerResults" class="customer-picker-results" role="listbox" hidden>
            <div id="customerSearchCount" class="customer-picker-result-summary">共 <%= customers.length %> 位客户</div>
            <button type="button" class="customer-picker-option" role="option" data-customer-id="" data-search="散客">
              <span class="customer-picker-name">散客</span>
            </button>
            <% customers.forEach(function(c) { %>
              <button type="button" class="customer-picker-option" role="option" data-customer-id="<%= c.id %>" data-search="<%= [c.name, c.contact, c.phone, c.address].filter(Boolean).join(' ').toLocaleLowerCase() %>">
                <span class="customer-picker-name"><%= c.name %></span>
                <span class="customer-picker-meta"><%= [c.contact, c.phone, c.address].filter(Boolean).join(' · ') || '未填写联系方式' %></span>
              </button>
            <% }) %>
            <p id="customerPickerEmpty" class="customer-picker-empty" hidden>没有匹配的客户</p>
          </div>
          <input type="hidden" name="customer_id" id="customerId" value="<%= form.customer_id || '' %>">
        </div>
      </div>
      <div class="form-row">
        <label>出库仓库 *</label>
        <select name="warehouse_id" required>
          <% warehouses.forEach(function(w) { %><option value="<%= w.id %>" <%= String(form.warehouse_id || '') === String(w.id) ? 'selected' : '' %>><%= w.name %></option><% }) %>
        </select>
      </div>
      <div class="form-row">
        <label>日期</label>
        <input type="date" name="order_date" value="<%= form.order_date || today %>">
      </div>
    </div>

    <h2 class="form-section-heading">商品明细</h2>
    <div id="items"></div>
    <button type="button" class="btn btn-secondary btn-sm" onclick="addRow(); saleFormDirty = true">＋ 添加商品</button>
    <p style="margin-top:10px;font-size:16px"><strong>商品合计：¥<span id="itemsTotal">0.00</span></strong> <span class="muted">（赠品不计入）</span></p>

    <h2 class="form-section-heading">金额与备注</h2>
    <div class="grid-3">
      <div class="form-row">
        <label>收款金额</label>
        <input type="number" name="paid_amount" placeholder="本次收款金额" step="0.01" min="0" value="<%= form.paid_amount != null ? form.paid_amount : 0 %>">
      </div>
      <div class="form-row">
        <label>备注</label>
        <input type="text" name="remarks" placeholder="备注信息" value="<%= form.remarks || '' %>">
      </div>
    </div>
    <details class="sale-note-panel" <%= form.note ? 'open' : '' %>><summary>内部备注（可选）</summary><div class="form-row"><label>仅内部查看</label><textarea name="note" rows="2"><%= form.note || '' %></textarea></div></details>

    <input type="hidden" name="items_json" id="itemsJson">

    <div class="form-actions sale-form-actions">
      <button class="btn" type="submit"><%= order ? '保存修改' : '提交审核' %></button>
      <% if (!order) { %>
        <button class="btn btn-secondary" type="submit" name="save_draft" value="1">存草稿</button>
      <% } %>
      <a class="btn btn-secondary" href="<%= order ? '/sales/' + order.id : (form.customer_id ? '/sales?customer_id=' + form.customer_id : '/sales') %>">取消</a>
    </div>
  </form>
</div>
<div class="sale-mobile-submit" aria-label="销售单操作"><div><small>商品合计</small><strong>¥<span id="stickyItemsTotal">0.00</span></strong></div><% if (!order) { %><button class="btn btn-secondary" type="submit" form="saleForm" name="save_draft" value="1">存草稿</button><% } %><button class="btn" type="submit" form="saleForm"><%= order ? '保存修改' : '提交审核' %></button></div>

<script>
  const PRODUCTS = <%- JSON.stringify(products).replace(/</g, '\\u003c') %>;

  // 客户选择器：搜索、结果与选中值是同一个组件，避免移动端原生 select 无法受外部搜索框控制。
  // 最终只向服务端提交 customer_id，既有客户归属权限校验不变。
  const customerSearch = document.getElementById('customerSearch');
  const customerPicker = document.getElementById('customerPicker');
  const customerResults = document.getElementById('customerPickerResults');
  const customerId = document.getElementById('customerId');
  const customerSearchCount = document.getElementById('customerSearchCount');
  const customerEmpty = document.getElementById('customerPickerEmpty');
  const clearCustomer = document.getElementById('clearCustomer');
  const customerOptions = Array.from(customerPicker.querySelectorAll('.customer-picker-option'));
  let activeCustomerOption = -1;

  function selectedCustomerOption() {
    return customerOptions.find(function(option) {
      return option.dataset.customerId === customerId.value;
    });
  }

  function customerLabel(option) {
    return option ? option.querySelector('.customer-picker-name').textContent.trim() : '';
  }

  function openCustomerPicker() {
    customerResults.hidden = false;
    customerSearch.setAttribute('aria-expanded', 'true');
    filterCustomers();
  }

  function closeCustomerPicker() {
    customerResults.hidden = true;
    customerSearch.setAttribute('aria-expanded', 'false');
    activeCustomerOption = -1;
    customerOptions.forEach(function(option) { option.classList.remove('active'); });
  }

  function selectCustomer(option) {
    customerId.value = option.dataset.customerId;
    customerSearch.value = customerLabel(option);
    clearCustomer.hidden = !customerId.value;
    customerOptions.forEach(function(item) {
      item.setAttribute('aria-selected', item === option ? 'true' : 'false');
    });
    closeCustomerPicker();
  }

  function filterCustomers() {
    const selected = selectedCustomerOption();
    const rawKeyword = customerSearch.value.trim().toLocaleLowerCase();
    // 已选客户重新点开时展示完整列表；输入新文字后再开始过滤。
    const keyword = selected && rawKeyword === customerLabel(selected).toLocaleLowerCase() ? '' : rawKeyword;
    let matched = 0;
    customerOptions.forEach(function(option) {
      const visible = !keyword || option.dataset.search.includes(keyword);
      option.hidden = !visible;
      if (visible) matched++;
    });
    customerEmpty.hidden = matched > 0;
    customerSearchCount.textContent = keyword ? `匹配 ${matched} 位客户` : `共 ${customerOptions.length - 1} 位客户`;
    activeCustomerOption = -1;
  }
  customerSearch.addEventListener('focus', function() {
    openCustomerPicker();
    if (customerId.value) customerSearch.select();
  });
  customerSearch.addEventListener('input', openCustomerPicker);
  customerSearch.addEventListener('keydown', function(event) {
    const visibleOptions = customerOptions.filter(function(option) { return !option.hidden; });
    if (event.key === 'Escape') {
      closeCustomerPicker();
      customerSearch.blur();
      return;
    }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (!visibleOptions.length) return;
      activeCustomerOption = event.key === 'ArrowDown'
        ? Math.min(activeCustomerOption + 1, visibleOptions.length - 1)
        : Math.max(activeCustomerOption - 1, 0);
      visibleOptions.forEach(function(option, index) { option.classList.toggle('active', index === activeCustomerOption); });
      visibleOptions[activeCustomerOption].scrollIntoView({ block: 'nearest' });
      return;
    }
    if (event.key === 'Enter') {
      event.preventDefault();
      const option = visibleOptions[activeCustomerOption] || visibleOptions[0];
      if (option) selectCustomer(option);
    }
  });
  customerOptions.forEach(function(option) {
    option.addEventListener('click', function() { selectCustomer(option); });
  });
  clearCustomer.addEventListener('click', function() {
    customerId.value = '';
    customerSearch.value = '';
    clearCustomer.hidden = true;
    openCustomerPicker();
    customerSearch.focus();
  });
  document.addEventListener('click', function(event) {
    if (!customerPicker.contains(event.target)) closeCustomerPicker();
  });
  const initialCustomer = selectedCustomerOption();
  if (initialCustomer && customerId.value) {
    customerSearch.value = customerLabel(initialCustomer);
    clearCustomer.hidden = false;
    initialCustomer.setAttribute('aria-selected', 'true');
  }
  // iOS 键盘的“搜索/完成”可能直接触发表单 submit；焦点仍在客户搜索框时，
  // 把它当作客户选择动作处理，不能让浏览器跳到后面的商品必填项。
  document.getElementById('saleForm').addEventListener('submit', function(event) {
    if (document.activeElement !== customerSearch) return;
    event.preventDefault();
    const option = customerOptions.find(function(item) { return !item.hidden; });
    if (option) selectCustomer(option);
  });

  // 编辑模式下，把已有明细转换成和新建表单一致的结构（quantity 用录入时的原始数量，配合 unit_choice 换算）
  const EXISTING_ITEMS = <%- JSON.stringify(typeof draftItems !== 'undefined' ? draftItems : (typeof existingItems !== 'undefined' ? existingItems : []).map(function(it) {
    const p = products.find(function(pr) { return pr.id === it.product_id; });
    const isPack = p && p.pack_unit && it.unit_label === p.pack_unit;
    return {
      id: it.product_id,
      quantity: it.quantity,
      price: it.unit_price,
      unit_choice: isPack ? 'pack' : 'base',
      is_gift: !!it.is_gift
    };
  })).replace(/</g, '\\u003c') %>;

  // HTML 转义：商品名/规格/单位是自由文本，经 innerHTML 拼 <option> 时
  // 若含 < > 引号会破坏 DOM 结构甚至注入脚本
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function setupProductPicker(row) {
    const search = row.querySelector('.product-search');
    const results = row.querySelector('.sale-product-results');
    const select = row.querySelector('select[name=product_id]');
    function showResults() {
      const keyword = search.value.trim().toLocaleLowerCase();
      const matches = PRODUCTS.filter(function(product) {
        return [product.name, product.sku, product.spec].filter(Boolean).join(' ').toLocaleLowerCase().includes(keyword);
      }).slice(0, 20);
      results.replaceChildren();
      matches.forEach(function(product) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'sale-product-option';
        button.textContent = product.name + (product.spec ? ' · ' + product.spec : '') + (product.sku ? ' · ' + product.sku : '');
        button.addEventListener('click', function() {
          select.value = String(product.id);
          onProductChange(select);
          recalcTotal();
          results.hidden = true;
          row.querySelector('input[name=quantity]').focus();
        });
        results.appendChild(button);
      });
      if (!matches.length) {
        const empty = document.createElement('p');
        empty.textContent = '没有匹配的商品';
        results.appendChild(empty);
      }
      results.hidden = false;
    }
    search.addEventListener('focus', function() { if (select.value) search.select(); showResults(); });
    search.addEventListener('input', function() { select.value = ''; search.setCustomValidity('请从搜索结果中选择商品'); showResults(); });
    search.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') results.hidden = true;
      if (event.key === 'Enter') {
        event.preventDefault();
        const first = results.querySelector('button');
        if (first) first.click();
      }
    });
    search.addEventListener('blur', function() { setTimeout(function() { results.hidden = true; }, 180); });
    select.addEventListener('change', function() { results.hidden = true; });
  }

  function addRow(initial) {
    const container = document.getElementById('items');
    const div = document.createElement('div');
    div.className = 'item-row';
    div.classList.add('sale-item-row');
    const options = PRODUCTS.map(p => `<option value="${p.id}" data-search="${esc([p.name, p.sku, p.spec].filter(Boolean).join(' '))}" data-price="${p.sale_price}" data-price-pack="${p.sale_price_pack != null ? p.sale_price_pack : ''}" data-unit="${esc(p.unit)}" data-pack-unit="${esc(p.pack_unit || '')}" data-pack-size="${p.pack_size || 1}">${esc(p.name)}${p.spec ? ' ('+esc(p.spec)+')' : ''}</option>`).join('');
    div.innerHTML = `
      <label class="sale-product-label">商品<input type="search" class="product-search" placeholder="输入名称或 SKU，点击结果选中" aria-label="搜索商品" autocomplete="off" required></label>
      <div class="sale-product-results" hidden></div>
      <select name="product_id" aria-label="商品" onchange="onProductChange(this)" tabindex="-1">
        <option value="">-- 选择商品 --</option>
        ${options}
      </select>
      <label class="sale-qty-field">数量<input type="number" name="quantity" placeholder="数量" min="1" required></label>
      <label class="sale-unit-field">单位<select name="unit_choice" class="unit-select" onchange="fillPrice(this.closest('.item-row').querySelector('select[name=product_id]'))">
        <option value="base">（先选商品）</option>
      </select></label>
      <label class="sale-price-field">销售单价<input type="number" name="unit_price" placeholder="销售单价" step="0.01" required></label>
      <label class="sale-gift-field">
        <input type="hidden" name="is_gift" value="0">
        <input type="checkbox" name="is_gift" value="1" class="gift-checkbox" onchange="toggleGift(this)"> 赠品
      </label>
      <span class="sale-line-total">小计 <strong>¥0.00</strong></span>
      <button type="button" class="btn btn-danger btn-sm sale-item-delete" onclick="this.closest('.item-row').remove(); recalcTotal();">删除</button>
    `;
    container.appendChild(div);
    setupProductPicker(div);

    if (initial) {
      const productSelect = div.querySelector('select[name=product_id]');
      productSelect.value = initial.id;
      if (productSelect.value) onProductChange(productSelect);
      const selectedOption = productSelect.options[productSelect.selectedIndex];
      div.querySelector('.product-search').value = selectedOption ? selectedOption.textContent : '';
      const unitSelect = div.querySelector('select[name=unit_choice]');
      unitSelect.value = initial.unit_choice;
      div.querySelector('input[name=quantity]').value = initial.quantity;
      const giftCheckbox = div.querySelector('.gift-checkbox');
      if (initial.is_gift) {
        giftCheckbox.checked = true;
        toggleGift(giftCheckbox);
      } else {
        div.querySelector('input[name=unit_price]').value = initial.price;
      }
    }
    recalcTotal();
  }

  function toggleGift(checkbox) {
    const row = checkbox.closest('.item-row');
    const priceInput = row.querySelector('input[name=unit_price]');
    if (checkbox.checked) {
      priceInput.value = '0';
      // 用 readOnly 而不是 disabled：disabled 的 input 不参与表单提交，
      // 一旦 JS 失效走了后端的表单数组回退路径，unit_price/is_gift 数组就会比其他数组短，
      // 数量跟价格错位、赠品标记串行。readOnly 照常提交值（赠品固定提交 0），数组保持对齐。
      priceInput.readOnly = true;
    } else {
      priceInput.readOnly = false;
      fillPrice(row.querySelector('select[name=product_id]'));
    }
  }

  function onProductChange(select) {
    const row = select.parentElement;
    const opt = select.options[select.selectedIndex];
    const unit = opt.getAttribute('data-unit');
    const packUnit = opt.getAttribute('data-pack-unit');
    const unitSelect = row.querySelector('select[name=unit_choice]');
    unitSelect.innerHTML = '';
    const baseOpt = document.createElement('option');
    baseOpt.value = 'base';
    baseOpt.textContent = unit || '基本单位';
    unitSelect.appendChild(baseOpt);
    if (packUnit) {
      const packOpt = document.createElement('option');
      packOpt.value = 'pack';
      packOpt.textContent = packUnit;
      unitSelect.appendChild(packOpt);
    }
    fillPrice(select);
    const search = row.querySelector('.product-search');
    if (opt.value) search.value = opt.textContent;
    search.setCustomValidity('');
  }

  function fillPrice(select) {
    const row = select.parentElement;
    const opt = select.options[select.selectedIndex];
    const basePrice = Number(opt.getAttribute('data-price')) || 0;
    const packPriceRaw = opt.getAttribute('data-price-pack');
    const packPrice = packPriceRaw !== null && packPriceRaw !== '' ? Number(packPriceRaw) : null;
    const packSize = Number(opt.getAttribute('data-pack-size')) || 1;
    const unitChoice = row.querySelector('select[name=unit_choice]').value;
    const priceInput = row.querySelector('input[name=unit_price]');
    const giftCheckbox = row.querySelector('.gift-checkbox');
    if (giftCheckbox && giftCheckbox.checked) {
      priceInput.value = '0';
      return;
    }
    // 整箱：优先用商品资料里精确录入的箱价，没填过箱价才退回"瓶价*换算比例"的旧算法（会有小数误差）
    const suggested = unitChoice === 'pack' ? (packPrice != null ? packPrice : basePrice * packSize) : basePrice;
    priceInput.value = suggested || '';
  }

  function recalcTotal() {
    const rows = document.querySelectorAll('#items .item-row');
    let total = 0;
    rows.forEach(function(row) {
      const qtyInput = row.querySelector('input[name=quantity]');
      const priceInput = row.querySelector('input[name=unit_price]');
      const giftCheckbox = row.querySelector('.gift-checkbox');
      const qty = parseFloat(qtyInput.value) || 0;
      const price = parseFloat(priceInput.value) || 0;
      const lineTotal = giftCheckbox && giftCheckbox.checked ? 0 : qty * price;
      row.querySelector('.sale-line-total strong').textContent = '¥' + lineTotal.toFixed(2);
      total += lineTotal;
    });
    const el = document.getElementById('itemsTotal');
    if (el) el.textContent = total.toFixed(2);
    document.getElementById('stickyItemsTotal').textContent = total.toFixed(2);
  }
  document.getElementById('items').addEventListener('input', recalcTotal);
  document.getElementById('items').addEventListener('change', recalcTotal);

  if (EXISTING_ITEMS.length > 0) {
    EXISTING_ITEMS.forEach(function(it) { addRow(it); });
  } else {
    addRow();
  }

  // 提交时收集所有商品行数据为 JSON
  document.getElementById('saleForm').addEventListener('submit', function(e) {
    if (e.defaultPrevented) return;
    const rows = document.querySelectorAll('#items .item-row');
    const items = [];
    rows.forEach(function(row) {
      const productSelect = row.querySelector('select[name=product_id]');
      const qtyInput = row.querySelector('input[name=quantity]');
      const priceInput = row.querySelector('input[name=unit_price]');
      const giftCheckbox = row.querySelector('.gift-checkbox');
      const unitChoiceSelect = row.querySelector('select[name=unit_choice]');
      if (!productSelect.value || !qtyInput.value) return;
      items.push({
        id: parseInt(productSelect.value),
        quantity: Number(qtyInput.value),
        price: parseFloat(priceInput.value) || 0,
        unit_choice: unitChoiceSelect ? unitChoiceSelect.value : 'base',
        is_gift: giftCheckbox ? giftCheckbox.checked : false
      });
    });
    let hidden = document.getElementById('itemsJson');
    if (!hidden) {
      hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'items_json';
      hidden.id = 'itemsJson';
      this.appendChild(hidden);
    }
    hidden.value = JSON.stringify(items);
    saleFormDirty = false;
  });
  let saleFormDirty = false;
  const saleForm = document.getElementById('saleForm');
  saleForm.addEventListener('input', function() { saleFormDirty = true; });
  saleForm.addEventListener('change', function() { saleFormDirty = true; });
  document.getElementById('items').addEventListener('click', function(event) {
    if (event.target.closest('.sale-item-delete, .sale-product-option')) saleFormDirty = true;
  });
  window.addEventListener('beforeunload', function(event) {
    if (!saleFormDirty) return;
    event.preventDefault();
    event.returnValue = '';
  });
</script>
<%- include('partials/footer') %>
