<%- include('partials/header') %>
<div class="dashboard-header-row">
  <h1>首页看板</h1>
  <% if (user.role === 'admin') { %>
    <a class="btn btn-secondary btn-sm dashboard-customize-btn" href="/settings/dashboard">⚙️ 看板设置</a>
  <% } %>
</div>

<% if (roleCards && roleCards.length > 0) { %>
<div class="stat-grid stat-grid-custom">
  <% roleCards.forEach(function(card) { %>
    <% if (card.adminOnly && user.role !== 'admin') return; %>
    <div class="stat-card stat-theme-<%= card.color %>" data-card-id="<%= card.id %>">
      <% if (card.id === 'monthly_sales') { %>
        <div class="num"><a class="stat-number-link" aria-label="查看本月已审核销售明细" href="/sales?status=approved&start=<%= today.slice(0,7) %>-01&end=<%= today %>">¥<%= monthlySales.toFixed(1) %></a></div>
        <div class="label"><%= card.label %></div>
      <% } else if (card.id === 'yearly_sales') { %>
        <div class="num"><a class="stat-number-link" aria-label="查看本年度已审核销售明细" href="/sales?status=approved&start=<%= yearStart %>&end=<%= today %>">¥<%= yearlySales.toFixed(1) %></a></div>
        <div class="label"><%= card.label %></div>
      <% } else if (card.id === 'monthly_net_debt') { %>
        <div class="num" style="color:<%= monthlyNetDebt > 0.001 ? '#dc2626' : '#16a34a' %>">
          <a class="stat-number-link" aria-label="查看未结清订单" href="/sales?settlement=outstanding"><%= monthlyNetDebt > 0.001 ? '+¥' + monthlyNetDebt.toFixed(1) : (monthlyNetDebt < -0.001 ? '-¥' + Math.abs(monthlyNetDebt).toFixed(1) : '¥0.0') %></a>
        </div>
        <div class="label"><%= card.label %></div>
        <div class="stat-subnote">
          <span class="stat-subnote-item">本月新欠 ¥<%= monthlyNewDebt.toFixed(1) %></span>
          <span class="stat-subnote-sep">·</span>
          <span class="stat-subnote-item">清收旧欠 ¥<%= monthlyClearedOldDebt.toFixed(1) %></span>
        </div>
      <% } else if (card.id === 'total_debt') { %>
        <div class="num" style="color:<%= totalDebt > 0.001 ? '#dc2626' : '#16a34a' %>"><a class="stat-number-link" aria-label="查看未结清订单" href="/sales?settlement=outstanding">¥<%= totalDebt.toFixed(1) %></a></div>
        <div class="label"><%= card.label %></div>
      <% } else if (card.id === 'monthly_profit' && user.role === 'admin' && monthlyProfit !== null) { %>
        <div class="num"><a class="stat-number-link" aria-label="查看本月已结清毛利明细" href="/reports?mode=without_receivable&start=<%= today.slice(0,7) %>-01&end=<%= today %>">¥<%= monthlyProfit.toFixed(1) %></a></div>
        <div class="label"><%= card.label %></div>
      <% } else if (card.id === 'pending_orders') { %>
        <div class="num" style="color:<%= pendingOrders > 0 ? '#d97706' : '#16a34a' %>"><%= pendingOrders %></div>
        <div class="label"><%= card.label %></div>
        <% if (user.role === 'admin') { %>
          <div class="pending-breakdown">
            <a class="pending-category<%= pendingSales === 0 ? ' is-empty' : '' %>" href="/sales?pending=1" aria-label="查看待审核销售单，共 <%= pendingSales %> 张">销售 <%= pendingSales %></a>
            <a class="pending-category<%= pendingReturns === 0 ? ' is-empty' : '' %>" href="/returns?pending=1" aria-label="查看待审核退货单，共 <%= pendingReturns %> 张">退货 <%= pendingReturns %></a>
            <a class="pending-category<%= pendingTransfers === 0 ? ' is-empty' : '' %>" href="/transfers?pending=1" aria-label="查看待审核调拨单，共 <%= pendingTransfers %> 张">调拨 <%= pendingTransfers %></a>
          </div>
        <% } %>
      <% } else if (card.id === 'today_sales') { %>
        <div class="num"><a class="stat-number-link" aria-label="查看今日已审核销售明细" href="/sales?status=approved&start=<%= today %>&end=<%= today %>">¥<%= todaySales.toFixed(1) %></a></div>
        <div class="label"><%= card.label %></div>
      <% } else if (card.id === 'today_profit' && user.role === 'admin' && todayProfit !== null) { %>
        <div class="num"><a class="stat-number-link" aria-label="查看今日已结清毛利明细" href="/reports?mode=without_receivable&start=<%= today %>&end=<%= today %>">¥<%= todayProfit.toFixed(1) %></a></div>
        <div class="label"><%= card.label %></div>
      <% } %>
    </div>
  <% }) %>
</div>
<% if (user.role === 'admin' && roleCards.some(function(c) { return c.id === 'monthly_profit' || c.id === 'today_profit'; })) { %>
  <p class="muted stat-note">毛利按已结清订单计算，已扣除退货。</p>
<% } %>
<% } %>

<% if (user.role === 'admin' && spPerf) { %>
<% const spAdminSuffix = spRange.includeAdmin ? '&sp_admin=1' : ''; %>
<div class="card dashboard-sp-card">
  <h2>业务员业绩排行
    <a class="section-link" href="/reports?mode=without_receivable&start=<%= spRange.start %>&end=<%= spRange.end %>">查看经营报表</a>
  </h2>
  <div class="dashboard-sp-toolbar">
    <div class="report-seg dashboard-sp-seg" role="group" aria-label="业绩时间范围">
      <a class="<%= spRange.key === 'today' ? 'is-active' : '' %>" href="/?sp=today<%= spAdminSuffix %>">今日</a>
      <a class="<%= spRange.key === 'month' ? 'is-active' : '' %>" href="/?sp=month<%= spAdminSuffix %>">本月</a>
      <a class="<%= spRange.key === 'year' ? 'is-active' : '' %>" href="/?sp=year<%= spAdminSuffix %>">本年</a>
    </div>
    <div class="report-seg dashboard-sp-role-seg" role="group" aria-label="业绩人员范围">
      <a class="<%= !spRange.includeAdmin ? 'is-active' : '' %>" href="/?sp=<%= spRange.key %>">仅操作员</a>
      <a class="<%= spRange.includeAdmin ? 'is-active' : '' %>" href="/?sp=<%= spRange.key %>&sp_admin=1">含管理员</a>
    </div>
  </div>
  <% if (spPerf.rows.length === 0) { %>
    <p class="muted">该时间范围暂无业绩数据</p>
  <% } else { %>
    <div class="desktop-table-wrap">
      <table>
        <tr><th>#</th><th>业务员</th><th>单数</th><th>净销售额</th><th>不含应收销售额</th><th>实现毛利（不含应收）</th><th>毛利率</th></tr>
        <% spPerf.rows.forEach(function(r, i) { const neg = r.realized_profit < -0.005; %>
          <tr>
            <td><%= r.unassigned ? '-' : i + 1 %></td>
            <td><%= r.name %><% if (r.role === 'admin') { %> <span class="badge badge-admin" style="font-size:11px;padding:1px 6px">管理员</span><% } %></td>
            <td><%= r.order_count %></td>
            <td>¥<%= r.net_sales.toFixed(1) %></td>
            <td>¥<%= r.settled_net_sales.toFixed(1) %></td>
            <td style="<%= neg ? 'color:#dc2626' : '' %>"><strong>¥<%= r.realized_profit.toFixed(1) %></strong></td>
            <td><%= r.margin_rate === null ? '-' : r.margin_rate.toFixed(1) + '%' %></td>
          </tr>
        <% }) %>
        <tr>
          <td></td><td><strong>合计</strong></td><td><%= spPerf.total.order_count %></td>
          <td>¥<%= spPerf.total.net_sales.toFixed(1) %></td>
          <td>¥<%= spPerf.total.settled_net_sales.toFixed(1) %></td>
          <td><strong>¥<%= spPerf.total.realized_profit.toFixed(1) %></strong></td>
          <td><%= spPerf.total.margin_rate === null ? '-' : spPerf.total.margin_rate.toFixed(1) + '%' %></td>
        </tr>
      </table>
    </div>
    <div class="mobile-order-cards">
      <% spPerf.rows.forEach(function(r, i) { const neg = r.realized_profit < -0.005; %>
        <div class="order-card">
          <div class="order-card-top">
            <span class="order-card-id"><%= r.unassigned ? '' : (i + 1) + '. ' %><%= r.name %><% if (r.role === 'admin') { %> <span class="badge badge-admin" style="font-size:11px;padding:1px 6px">管理员</span><% } %></span>
            <span class="muted"><%= r.order_count %> 单</span>
          </div>
          <div class="order-card-mid">
            <span>净销售 ¥<%= r.net_sales.toFixed(1) %></span>
            <span>不含应收 ¥<%= r.settled_net_sales.toFixed(1) %></span>
          </div>
          <div class="order-card-bottom">
            <span class="muted">实现毛利 <strong style="<%= neg ? 'color:#dc2626' : '' %>">¥<%= r.realized_profit.toFixed(1) %></strong></span>
            <span class="<%= neg ? 'text-danger' : 'muted' %>">毛利率 <%= r.margin_rate === null ? '-' : r.margin_rate.toFixed(1) + '%' %></span>
          </div>
        </div>
      <% }) %>
      <div class="muted">合计：净销售 ¥<%= spPerf.total.net_sales.toFixed(1) %> · 不含应收 ¥<%= spPerf.total.settled_net_sales.toFixed(1) %> · 实现毛利 ¥<%= spPerf.total.realized_profit.toFixed(1) %></div>
    </div>
  <% } %>
</div>
<% } %>

<% if (lowStock.length > 0) { %>
<div class="card">
  <h2>库存预警 <a class="section-link" href="/inventory?low=1">查看低库存</a></h2>
    <div class="desktop-table-wrap">
      <table>
        <tr><th>商品</th><th>仓库</th><th>当前库存</th><th>预警阈值</th></tr>
        <% lowStock.forEach(function(r) { %>
          <tr>
            <td><%= r.name %></td>
            <td><%= r.warehouse_name %></td>
            <td><span class="badge badge-low"><%= r.quantity %> <%= r.unit %></span></td>
            <td><%= r.low_stock_threshold %></td>
          </tr>
        <% }) %>
      </table>
    </div>
    <div class="mobile-order-cards">
      <% lowStock.forEach(function(r) { %>
        <div class="order-card">
          <div class="order-card-top">
            <span class="order-card-id"><%= r.name %></span>
            <span class="badge badge-low"><%= r.quantity %> <%= r.unit %></span>
          </div>
          <div class="order-card-mid">
            <span><%= r.warehouse_name %></span>
            <span>预警阈值 <%= r.low_stock_threshold %></span>
          </div>
        </div>
      <% }) %>
    </div>
</div>
<% } %>

<div class="card">
  <h2>最近销售单</h2>
  <% if (recentSales.length === 0) { %>
    <p class="muted">暂无销售记录</p>
  <% } else { %>
    <div class="desktop-table-wrap">
      <table>
        <tr><th>单号</th><th>日期</th><th>客户</th><th>仓库</th><th>金额</th><th>收款状态</th><th>审核状态</th></tr>
        <% recentSales.forEach(function(o) { %>
          <tr>
            <td><a href="/sales/<%= o.id %>">#<%= o.id %></a></td>
            <td><%= o.order_date %></td>
            <td><%= o.customer_name || '散客' %></td>
            <td><%= o.warehouse_name %></td>
            <td>¥<%= o.total_amount.toFixed(1) %></td>
            <td>
              <%- include('partials/payment_status', { order: o }) %>
            </td>
            <td>
              <%- include('partials/order_status', { status: o.status }) %>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
    <div class="mobile-order-cards">
      <% recentSales.forEach(function(o) { %>
        <a href="/sales/<%= o.id %>" class="order-card">
          <div class="order-card-top">
            <span class="order-card-id">#<%= o.id %> <%= o.customer_name || '散客' %></span>
            <%- include('partials/order_status', { status: o.status }) %>
          </div>
          <div class="order-card-mid">
            <span><%= o.order_date %></span>
            <span><%= o.warehouse_name %></span>
          </div>
          <div class="order-card-bottom">
            <span class="order-card-amount">¥<%= o.total_amount.toFixed(1) %></span>
            <%- include('partials/payment_status', { order: o }) %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
