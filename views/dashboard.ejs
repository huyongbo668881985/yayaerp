<%- include('partials/header') %>
<h1>首页看板</h1>

<div class="stat-grid stat-grid-primary">
  <div class="stat-card">
    <div class="num"><a class="stat-number-link" aria-label="查看今日已审核销售明细" href="/sales?status=approved&start=<%= today %>&end=<%= today %>">¥<%= todaySales.toFixed(2) %></a></div>
    <div class="label">今日销售额（已审核）</div>
  </div>
  <div class="stat-card">
    <div class="num"><a class="stat-number-link" aria-label="查看本月已审核销售明细" href="/sales?status=approved&start=<%= today.slice(0,7) %>-01&end=<%= today %>">¥<%= monthlySales.toFixed(2) %></a></div>
    <div class="label">本月销售额（已审核）</div>
  </div>
  <div class="stat-card">
    <div class="num" style="color:<%= totalDebt > 0 ? '#e5484d' : '#16a34a' %>"><a class="stat-number-link" aria-label="查看未结清订单" href="/sales?settlement=outstanding">¥<%= totalDebt.toFixed(2) %></a></div>
    <div class="label">总欠款</div>
  </div>
  <div class="stat-card">
    <div class="num" style="color:<%= pendingOrders > 0 ? '#f59e0b' : '#16a34a' %>"><%= pendingOrders %></div>
    <div class="label">待审核单据</div>
    <% if (user.role === 'admin') { %>
      <a class="section-link pending-orders-link" href="/sales?pending=1">查看未审核订单明细 →</a>
      <div class="pending-breakdown"><span>销售 <%= pendingSales %></span><a href="/returns?pending=1">退货 <%= pendingReturns %></a><a href="/transfers?pending=1">调拨 <%= pendingTransfers %></a></div>
    <% } %>
  </div>
</div>

<% if (lowStock.length > 0) { %>
<div class="card">
  <h2>库存预警 <a class="section-link" href="/inventory?low=1">查看低库存</a></h2>
    <div class="desktop-table-wrap">
      <table>
        <tr><th>商品</th><th>仓库</th><th>当前库存</th><th>预警阈值</th></tr>
        <% lowStock.forEach(function(r) { %>
          <tr>
            <td><%= r.name %></td>
            <td><%= r.warehouse_name %></td>
            <td><span class="badge badge-low"><%= r.quantity %> <%= r.unit %></span></td>
            <td><%= r.low_stock_threshold %></td>
          </tr>
        <% }) %>
      </table>
    </div>
    <div class="mobile-order-cards">
      <% lowStock.forEach(function(r) { %>
        <div class="order-card">
          <div class="order-card-top">
            <span class="order-card-id"><%= r.name %></span>
            <span class="badge badge-low"><%= r.quantity %> <%= r.unit %></span>
          </div>
          <div class="order-card-mid">
            <span><%= r.warehouse_name %></span>
            <span>预警阈值 <%= r.low_stock_threshold %></span>
          </div>
        </div>
      <% }) %>
    </div>
</div>
<% } %>

<% if (user.role === 'admin') { %>
  <div class="stat-grid stat-grid-secondary">
    <div class="stat-card">
      <div class="num"><a class="stat-number-link" aria-label="查看今日已结清毛利明细" href="/reports?mode=without_receivable&start=<%= today %>&end=<%= today %>">¥<%= todayProfit.toFixed(2) %></a></div>
      <div class="label">今日毛利（已结清）</div>
    </div>
    <div class="stat-card">
      <div class="num"><a class="stat-number-link" aria-label="查看本月已结清毛利明细" href="/reports?mode=without_receivable&start=<%= today.slice(0,7) %>-01&end=<%= today %>">¥<%= monthlyProfit.toFixed(2) %></a></div>
      <div class="label">本月毛利（已结清）</div>
    </div>
  </div>
  <p class="muted stat-note">毛利按已结清订单计算，已扣除退货。</p>
<% } %>

<div class="card">
  <h2>最近销售单</h2>
  <% if (recentSales.length === 0) { %>
    <p class="muted">暂无销售记录</p>
  <% } else { %>
    <div class="desktop-table-wrap">
      <table>
        <tr><th>单号</th><th>日期</th><th>客户</th><th>仓库</th><th>金额</th><th>收款状态</th><th>审核状态</th></tr>
        <% recentSales.forEach(function(o) { %>
          <tr>
            <td><a href="/sales/<%= o.id %>">#<%= o.id %></a></td>
            <td><%= o.order_date %></td>
            <td><%= o.customer_name || '散客' %></td>
            <td><%= o.warehouse_name %></td>
            <td>¥<%= o.total_amount.toFixed(2) %></td>
            <td>
              <%- include('partials/payment_status', { order: o }) %>
            </td>
            <td>
              <%- include('partials/order_status', { status: o.status }) %>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
    <div class="mobile-order-cards">
      <% recentSales.forEach(function(o) { %>
        <a href="/sales/<%= o.id %>" class="order-card">
          <div class="order-card-top">
            <span class="order-card-id">#<%= o.id %> <%= o.customer_name || '散客' %></span>
            <%- include('partials/order_status', { status: o.status }) %>
          </div>
          <div class="order-card-mid">
            <span><%= o.order_date %></span>
            <span><%= o.warehouse_name %></span>
          </div>
          <div class="order-card-bottom">
            <span class="order-card-amount">¥<%= o.total_amount.toFixed(2) %></span>
            <%- include('partials/payment_status', { order: o }) %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
