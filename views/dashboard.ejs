<%- include('partials/header') %>
<h1>首页看板</h1>

<div class="stat-grid">
  <div class="stat-card">
    <div class="num">¥<%= todaySales.toFixed(2) %></div>
    <div class="label">今日销售额（已审核）</div>
  </div>
  <div class="stat-card">
    <div class="num">¥<%= monthlySales.toFixed(2) %></div>
    <div class="label">本月销售额（已审核）</div>
  </div>
  <div class="stat-card">
    <div class="num" style="color:<%= totalDebt > 0 ? '#e5484d' : '#16a34a' %>">¥<%= totalDebt.toFixed(2) %></div>
    <div class="label">总欠款</div>
  </div>
  <div class="stat-card">
    <div class="num" style="color:<%= pendingOrders > 0 ? '#f59e0b' : '#16a34a' %>"><%= pendingOrders %></div>
    <div class="label">待审核单据</div>
  </div>
  <% if (user.role === 'admin') { %>
    <div class="stat-card">
      <div class="num">¥<%= todayProfit.toFixed(2) %></div>
      <div class="label">今日毛利（已收款订单，已扣退货）</div>
    </div>
    <div class="stat-card">
      <div class="num">¥<%= monthlyProfit.toFixed(2) %></div>
      <div class="label">本月毛利（已收款订单，已扣退货）</div>
    </div>
  <% } %>
</div>

<div class="card">
  <h2>库存预警</h2>
  <% if (lowStock.length === 0) { %>
    <p class="muted">暂无库存预警商品</p>
  <% } else { %>
    <div class="desktop-table-wrap">
      <table>
        <tr><th>商品</th><th>仓库</th><th>当前库存</th><th>预警阈值</th></tr>
        <% lowStock.forEach(function(r) { %>
          <tr>
            <td><%= r.name %></td>
            <td><%= r.warehouse_name %></td>
            <td><span class="badge badge-low"><%= r.quantity %> <%= r.unit %></span></td>
            <td><%= r.low_stock_threshold %></td>
          </tr>
        <% }) %>
      </table>
    </div>
    <div class="mobile-order-cards">
      <% lowStock.forEach(function(r) { %>
        <div class="order-card">
          <div class="order-card-top">
            <span class="order-card-id"><%= r.name %></span>
            <span class="badge badge-low"><%= r.quantity %> <%= r.unit %></span>
          </div>
          <div class="order-card-mid">
            <span><%= r.warehouse_name %></span>
            <span>预警阈值 <%= r.low_stock_threshold %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<div class="card">
  <h2>最近销售单</h2>
  <% if (recentSales.length === 0) { %>
    <p class="muted">暂无销售记录</p>
  <% } else { %>
    <div class="desktop-table-wrap">
      <table>
        <tr><th>单号</th><th>日期</th><th>客户</th><th>仓库</th><th>金额</th><th>收款状态</th><th>审核状态</th></tr>
        <% recentSales.forEach(function(o) { %>
          <tr>
            <td><a href="/sales/<%= o.id %>">#<%= o.id %></a></td>
            <td><%= o.order_date %></td>
            <td><%= o.customer_name || '散客' %></td>
            <td><%= o.warehouse_name %></td>
            <td>¥<%= o.total_amount.toFixed(2) %></td>
            <td>
              <% if (o.effective_status === 'paid') { %>
                <span class="badge" style="background:#dcfce7;color:#166534">已收款</span>
              <% } else if (o.effective_status === 'partial') { %>
                <span class="badge" style="background:#fef3c7;color:#92400e">部分收款</span>
              <% } else { %>
                <span class="badge" style="background:#fee2e2;color:#991b1b">未收款</span>
              <% } %>
            </td>
            <td>
              <% if (o.status === 'approved') { %>
                <span class="badge" style="background:#dbeafe;color:#1e40af">已审核</span>
              <% } else { %>
                <span class="badge" style="background:#f3f4f6;color:#6b7280">待审核</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
    <div class="mobile-order-cards">
      <% recentSales.forEach(function(o) { %>
        <a href="/sales/<%= o.id %>" class="order-card">
          <div class="order-card-top">
            <span class="order-card-id">#<%= o.id %> <%= o.customer_name || '散客' %></span>
            <% if (o.status === 'approved') { %>
              <span class="badge" style="background:#dbeafe;color:#1e40af">已审核</span>
            <% } else { %>
              <span class="badge" style="background:#f3f4f6;color:#6b7280">待审核</span>
            <% } %>
          </div>
          <div class="order-card-mid">
            <span><%= o.order_date %></span>
            <span><%= o.warehouse_name %></span>
          </div>
          <div class="order-card-bottom">
            <span class="order-card-amount">¥<%= o.total_amount.toFixed(2) %></span>
            <% if (o.effective_status === 'paid') { %>
              <span class="badge" style="background:#dcfce7;color:#166534">已收款</span>
            <% } else if (o.effective_status === 'partial') { %>
              <span class="badge" style="background:#fef3c7;color:#92400e">部分收款</span>
            <% } else { %>
              <span class="badge" style="background:#fee2e2;color:#991b1b">未收款</span>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
