<% const query=new URLSearchParams({start,end}).toString(); %>
<% if(!print) { %><%- include('partials/header') %>
<div class="page-heading-actions"><h1><%= customer.name %> · 客户对账单</h1><div class="action-row"><a class="btn btn-secondary" href="/reconciliation">返回对账</a><a class="btn btn-secondary" href="?format=csv&<%= query %>">导出 CSV</a><a class="btn" href="?print=1&<%= query %>">打印 / PDF</a></div></div>
<% } else { %><%- include('partials/print_head',{title:customer.name+' · 客户对账单',back:'?'+query,receipt:false}) %><% } %>
<% if(data.unverifiedReturnAccounts){ %><p class="flow-notice">有 <%= data.unverifiedReturnAccounts %> 笔历史退货流水缺少可还原的关联审计。旧金额保持原样，管理员需核对历史原单归属后使用分单应收和待退款汇总。</p><% } %>
<p><%= start %> 至 <%= end %> · 客户：<%= customer.name %><% if(customer.phone){ %> · 电话：<%= customer.phone %><% } %></p>
<p class="muted">按实际入账日期；<%= data.openingDate %> 的“升级结转”为旧账累计金额，不代表当日实际收款。余额为正表示净应收，为负表示净待退；不同单据不会自动冲抵。</p>
<div class="statement-totals"><div><span>期初净余额</span><strong>¥<%= money(data.opening) %></strong></div><div><span>本期销售</span><strong>¥<%= money(data.totals.sales) %></strong></div><div><span>本期现金收款</span><strong>¥<%= money(data.totals.received) %></strong></div><div><span>本期退货</span><strong>¥<%= money(data.totals.returned) %></strong></div><div><span>本期现金退款</span><strong>¥<%= money(data.totals.refunded) %></strong></div><div><span>期末净余额</span><strong>¥<%= money(data.ending) %></strong></div></div>
<p>截至 <%= end %> 分单汇总：应收 ¥<%= money(data.receivable) %>；待退 ¥<%= money(data.refundPending) %>。</p>
<div class="<%= print?'':'card statement-table-wrap' %>"><table><thead><tr><th>入账日期 / 业务</th><th>单号</th><th>销售</th><th>收款</th><th>退货</th><th>退款</th><th>余额</th></tr></thead><tbody><tr><td>期初余额</td><td colspan="5"></td><td><%= money(data.opening) %></td></tr><% data.rows.forEach(function(row){ %><tr><td><%= row.event_date %><small><%= row.event_kind %></small></td><td><% if(!print){ %><a href="/<%= row.document_type %>/<%= row.document_id %>"><% } %><%= row.document_type==='sales'?'销售':'退货' %> #<%= row.document_id %><% if(!print){ %></a><% } %><small>单据日期 <%= row.document_date %></small></td><% ['sales','received','returned','refunded','balance'].forEach(function(key){ %><td><%= money(row[key+'_cents']) %></td><% }); %></tr><% }); %><tr><th>本期合计</th><td></td><% ['sales','received','returned','refunded'].forEach(function(key){ %><th><%= money(data.totals[key]) %></th><% }); %><th><%= money(data.ending) %></th></tr></tbody></table></div>
<% if(!print){ %><div class="mobile-order-cards"><% data.rows.forEach(function(row){ %><div class="order-card"><div class="order-card-top"><strong><%= row.event_kind %> · <%= row.document_type==='sales'?'销售':'退货' %> #<%= row.document_id %></strong><span><%= row.event_date %></span></div><p>销售 ¥<%= money(row.sales_cents) %> · 收款 ¥<%= money(row.received_cents) %></p><p>退货 ¥<%= money(row.returned_cents) %> · 退款 ¥<%= money(row.refunded_cents) %></p><strong>余额 ¥<%= money(row.balance_cents) %></strong></div><% }); %></div><% } %>
<% if(!data.rows.length){ %><p class="muted">本期无账务变动；期末余额承接期初。</p><% } %>
<% if(print){ %><div class="print-signatures"><span>经办人：________</span><span>客户确认：________</span></div><%- include('partials/print_foot') %><% } else { %><%- include('partials/footer') %><% } %>
