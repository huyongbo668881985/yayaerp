<%- include('partials/header') %>
<h1>销售单 #<%= order.id %></h1>
<div class="detail-print-actions"><a class="btn btn-secondary" href="/sales/<%= order.id %>/print">打印 / PDF</a></div>
<% if (created) { %><div class="flow-notice" role="status"><strong><%= created === 'draft' ? '草稿已保存' : '已提交审核' %></strong><span><%= created === 'draft' ? '可以继续编辑，准备好后再提交审核。' : '审核通过后才会扣减库存。' %></span></div><% } %>
<% if (responsibleUpdated) { %><div class="flow-notice" role="status"><strong>负责人已更新</strong><span>录入人仍保留，可在操作日志中查看调整记录。</span></div><% } %>
<% if (responsibleError) { %><div class="error" role="alert"><%= responsibleError %></div><% } %>
<div class="card">
  <div class="detail-hero">
    <div><span class="detail-eyebrow">销售单 #<%= order.id %> · <%= order.order_date %></span><strong><%= order.customer_name || '散客' %></strong></div>
    <div class="detail-hero-value"><span>订单金额</span><strong>¥<%= order.total_amount.toFixed(2) %></strong></div>
  </div>
  <div class="detail-meta">
    <div><span>仓库</span><strong><%= order.warehouse_name %></strong></div>
    <div><span>负责人</span><strong><%= order.responsible_name %></strong></div>
    <div><span>录入人</span><strong><%= order.user_name %></strong></div>
    <div><span>录入时间</span><strong><%= formatDateTime(order.created_at).slice(0, 16) %></strong></div>
    <div><span>备注</span><strong><%= order.remarks || '-' %></strong></div>
    <% if (order.note) { %><div><span>内部备注</span><strong><%= order.note %></strong></div><% } %>
  </div>
  <% if (canManage) { %>
  <details class="sales-responsible-edit" <%= responsibleError ? 'open' : '' %>>
    <summary>调整负责人</summary>
    <form method="POST" action="/sales/<%= order.id %>/responsible">
      <input type="hidden" name="_request_key" value="<%= newRequestKey() %>">
      <input type="hidden" name="responsible_revision" value="<%= order.revision %>">
      <div class="form-row"><label for="detailResponsible">负责人</label>
        <select name="responsible_id" id="detailResponsible" required><% responsibleOptions.forEach(function(person) { %><option value="<%= person.id %>" <%= person.id === (order.responsible_id || order.user_id) ? 'selected' : '' %>><%= person.name %>（<%= person.username %>）<%= person.active ? '' : ' · 已停用' %></option><% }) %></select>
      </div>
      <button class="btn btn-secondary" type="submit">保存负责人</button>
    </form>
  </details>
  <% } %>
  <div class="detail-status-list">
    <div><span>结算状态</span>
    <%- include('partials/payment_status', { order: order }) %>
    </div>
    <div><span>审核状态</span>
    <%- include('partials/order_status', { status: order.status }) %>
    </div>
  </div>
    <% if (order.status === 'draft' || order.status === 'submitted') { %>
      <p class="detail-state-note">未审核，库存尚未变动</p>
    <% } %>
  <div class="detail-finance-grid">
    <div><span><%= order.status === 'approved' ? '已收款' : '录入收款' %></span><strong>¥<%= (order.paid_amount || 0).toFixed(2) %></strong></div>
    <% if (order.returned_amount > 0) { %><div><span>已审核退货</span><strong>¥<%= order.returned_amount.toFixed(2) %></strong></div><% } %>
    <% if (order.cash_refunded_amount > 0) { %><div><span>已退现金</span><strong>¥<%= order.cash_refunded_amount.toFixed(2) %></strong></div><% } %>
    <% if (order.pending_refund > 0) { %><div><span>待退现金</span><strong class="detail-owing">¥<%= order.pending_refund.toFixed(2) %></strong></div><% } %>
    <div><span><%= order.status === 'approved' ? '欠款' : '预计待收' %></span><strong class="<%= order.status === 'approved' ? 'detail-owing' : '' %>">¥<%= order.effective_debt.toFixed(2) %></strong></div>
  </div>
  <% if (relatedReturns && relatedReturns.length > 0) { %>
    <p>
      <strong>关联退货单：</strong>
      <% relatedReturns.forEach(function(ro, idx) { %><a href="/returns/<%= ro.id %>">#<%= ro.id %></a>（¥<%= ro.total_amount.toFixed(2) %>，<%= ro.cancelled_at ? '已撤销' : ro.status === 'approved' ? '已审核' : (ro.status === 'submitted' ? '待审核' : (ro.status === 'rejected' ? '已拒绝' : '草稿')) %>）<%= idx < relatedReturns.length - 1 ? '、' : '' %><% }) %>
    </p>
  <% } %>
  <h2 class="detail-section-heading">商品明细</h2>
  <table class="detail-items-table">
    <tr><th>商品</th><th>数量</th><th>单价</th><th>小计</th><th>类型</th></tr>
    <% items.forEach(function(it) { %>
      <tr>
        <td><%= it.product_name %></td>
        <td><%= it.quantity %> <%= it.unit_label %></td>
        <td>¥<%= it.unit_price.toFixed(2) %></td>
        <td>¥<%= (it.quantity * it.unit_price).toFixed(2) %></td>
        <td><%= it.is_gift ? '赠品' : '正常销售' %></td>
      </tr>
    <% }) %>
  </table>
  <div class="detail-items-mobile">
    <% items.forEach(function(it) { %>
      <div class="detail-item-card"><div><strong><%= it.product_name %></strong><span><%= it.quantity %> <%= it.unit_label %> × ¥<%= it.unit_price.toFixed(2) %><% if (it.is_gift) { %> · 赠品<% } %></span></div><strong>¥<%= (it.quantity * it.unit_price).toFixed(2) %></strong></div>
    <% }) %>
  </div>
  <p class="right"><strong>总计：¥<%= order.total_amount.toFixed(2) %></strong></p>

  <div class="detail-actions">
    <% if (order.status === 'draft' && canManage) { %>
      <a class="btn" href="/sales/<%= order.id %>/edit">编辑</a>
      <form action="/sales/submit/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">提交审核</button>
      </form>
      <form action="/sales/<%= order.id %>/delete" method="POST" onsubmit="return confirm('确认删除这张未提交的草稿销售单？删除后无法恢复。')">
        <button type="submit" class="btn btn-danger">删除草稿</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && canManage) { %>
      <form action="/sales/withdraw/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-secondary">撤回修改</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && currentUser.role === 'admin') { %>
      <form action="/sales/approve/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">审核通过</button>
      </form>
      <form action="/sales/reject/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-danger">审核拒绝</button>
      </form>
    <% } %>

    <% if ((order.status === 'approved' || order.status === 'rejected') && currentUser.role === 'admin') { %>
      <% if (relatedReturns.some(ro => ro.finalized_at)) { %>
        <p class="muted">已有退货入账历史，原销售单和明细固定，不能反审核改写。</p>
      <% } else { %>
      <form action="/sales/unapprove/<%= order.id %>" method="POST" onsubmit="return confirm('反审核会把该订单退回待审核状态<% if (order.status === 'approved') { %>，并把已扣减的库存加回来<% } %>，确认继续？')">
        <button type="submit" class="btn btn-secondary">反审核</button>
      </form>
      <% } %>
    <% } %>

    <% if (order.status === 'approved' && currentUser.role === 'admin' && order.effective_debt > 0.001) { %>
      <form action="/sales/<%= order.id %>/record-payment" method="POST" style="display:flex; gap:6px; align-items:center">
        <input type="hidden" name="_request_key" value="<%= newRequestKey() %>">
        <input type="number" name="amount" placeholder="本次收款金额" step="0.01" min="0.01" max="<%= order.effective_debt.toFixed(2) %>" required style="width:140px">
        <button type="submit" class="btn" style="background:#16a34a">记录收款</button>
      </form>
    <% } %>

    <% if (order.status === 'approved' && canManage) { %>
      <a class="btn btn-secondary" href="/returns/new?sale_id=<%= order.id %>">为这张销售单办理退货</a>
    <% } %>

    <a class="btn btn-secondary" href="/sales<%= order.customer_id ? '?customer_id=' + order.customer_id : '' %>">返回列表</a>
  </div>
</div>
<%- include('partials/footer') %>
