<%- include('partials/header') %>
<h1>销售单 #<%= order.id %></h1>
<div class="card">
  <p>
    <strong>日期：</strong><%= order.order_date %> &nbsp;
    <strong>客户：</strong><%= order.customer_name || '散客' %> &nbsp;
    <strong>仓库：</strong><%= order.warehouse_name %>
  </p>
  <p>
    <strong>录入人：</strong><%= order.user_name %> &nbsp;
    <strong>备注：</strong><%= order.note || '-' %>
  </p>
  <p>
    <strong>收款状态：</strong>
    <% if (order.effective_status === 'paid') { %>
      <span class="badge" style="background:#dcfce7;color:#166534">已收款</span>
    <% } else if (order.effective_status === 'partial') { %>
      <span class="badge" style="background:#fef3c7;color:#92400e">部分收款</span>
    <% } else { %>
      <span class="badge" style="background:#fee2e2;color:#991b1b">未收款</span>
    <% } %>
    &nbsp;
    <strong>审核状态：</strong>
    <%
      const statusMap = {
        draft:     { text: '草稿',   bg: '#f3f4f6', fg: '#6b7280' },
        submitted: { text: '待审核', bg: '#fef3c7', fg: '#92400e' },
        approved:  { text: '已审核', bg: '#dbeafe', fg: '#1e40af' },
        rejected:  { text: '已拒绝', bg: '#fee2e2', fg: '#991b1b' }
      };
      const st = statusMap[order.status] || { text: order.status, bg: '#f3f4f6', fg: '#6b7280' };
    %>
    <span class="badge" style="background:<%= st.bg %>;color:<%= st.fg %>"><%= st.text %></span>
    <% if (order.status === 'draft' || order.status === 'submitted') { %>
      <span class="muted">（未审核，库存尚未变动）</span>
    <% } %>
  </p>
  <p>
    <strong>总金额：</strong>¥<%= order.total_amount.toFixed(2) %> &nbsp;
    <strong>已收款：</strong>¥<%= (order.paid_amount || 0).toFixed(2) %>
    <% if (order.returned_amount > 0) { %> &nbsp; <strong>已扣退货：</strong>¥<%= order.returned_amount.toFixed(2) %><% } %>
    &nbsp;
    <strong>欠款：</strong>¥<%= order.effective_debt.toFixed(2) %>
  </p>
  <% if (relatedReturns && relatedReturns.length > 0) { %>
    <p>
      <strong>关联退货单：</strong>
      <% relatedReturns.forEach(function(ro, idx) { %><a href="/returns/<%= ro.id %>">#<%= ro.id %></a>（¥<%= ro.total_amount.toFixed(2) %>，<%= ro.status === 'approved' ? '已审核' : (ro.status === 'submitted' ? '待审核' : (ro.status === 'rejected' ? '已拒绝' : '草稿')) %>）<%= idx < relatedReturns.length - 1 ? '、' : '' %><% }) %>
    </p>
  <% } %>
  <table>
    <tr><th>商品</th><th>数量</th><th>单价</th><th>小计</th><th>类型</th></tr>
    <% items.forEach(function(it) { %>
      <tr>
        <td><%= it.product_name %></td>
        <td><%= it.quantity %> <%= it.unit_label %></td>
        <td>¥<%= it.unit_price.toFixed(2) %></td>
        <td>¥<%= (it.quantity * it.unit_price).toFixed(2) %></td>
        <td><%= it.is_gift ? '赠品' : '正常销售' %></td>
      </tr>
    <% }) %>
  </table>
  <p class="right"><strong>总计：¥<%= order.total_amount.toFixed(2) %></strong></p>

  <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px">
    <% if (order.status === 'draft' && canManage) { %>
      <a class="btn" href="/sales/<%= order.id %>/edit">编辑</a>
      <form action="/sales/submit/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">提交审核</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && canManage) { %>
      <form action="/sales/withdraw/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-secondary">撤回修改</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && currentUser.role === 'admin') { %>
      <form action="/sales/approve/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">审核通过</button>
      </form>
      <form action="/sales/reject/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-danger">审核拒绝</button>
      </form>
    <% } %>

    <% if ((order.status === 'approved' || order.status === 'rejected') && currentUser.role === 'admin') { %>
      <form action="/sales/unapprove/<%= order.id %>" method="POST" onsubmit="return confirm('反审核会把该订单退回待审核状态<% if (order.status === 'approved') { %>，并把已扣减的库存加回来<% } %>，确认继续？')">
        <button type="submit" class="btn btn-secondary">反审核</button>
      </form>
    <% } %>

    <% if (order.status === 'approved' && currentUser.role === 'admin' && order.effective_debt > 0.001) { %>
      <form action="/sales/<%= order.id %>/record-payment" method="POST" style="display:flex; gap:6px; align-items:center">
        <input type="number" name="amount" placeholder="本次收款金额" step="0.01" min="0.01" required style="width:140px">
        <button type="submit" class="btn" style="background:#16a34a">记录收款</button>
      </form>
    <% } %>

    <a class="btn btn-secondary" href="/sales">返回列表</a>
  </div>
</div>
<%- include('partials/footer') %>
