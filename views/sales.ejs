<%- include('partials/header') %>
<div class="tabbar">
  <a href="/sales" class="active">销售订单</a>
  <a href="/sales/summary">客户销售汇总</a>
  <a href="/returns">退货</a>
</div>
<h1>销售订单</h1>
<% const selectedCustomer = customers.find(function(customer) { return customer.id === customerId; }); %>
<% if (selectedCustomer) { %>
  <div class="sales-customer-context"><span>正在查看 <strong><%= selectedCustomer.name %></strong> 的订单</span><a href="/customers">返回客户</a></div>
<% } %>
<div style="margin-bottom:12px; display:flex; gap:8px; flex-wrap:wrap">
  <a class="btn" href="/sales/new<%= selectedCustomer ? '?customer_id=' + selectedCustomer.id : '' %>">+ 新建销售单</a>
  <a class="btn <%= orderStatus === 'draft' ? '' : 'btn-secondary' %>" href="/sales<%= salesQueryString({ status: orderStatus === 'draft' ? '' : 'draft', pending: '' }) %>"><%= orderStatus === 'draft' ? '查看全部订单' : '草稿箱（' + draftCount + '）' %></a>
  <% if (currentUser.role === 'admin') { %>
    <a class="btn <%= pendingOnly ? '' : 'btn-secondary' %>" href="/sales<%= salesQueryString({ pending: pendingOnly ? '' : 1, status: '', customer_id: customerId }) %>">未审核订单</a>
  <% } %>
</div>

<%
  const selectedResponsible = responsibleOptions.find(person => person.id === responsibleId);
  const selectedTag = tags.find(tag => tag.id === tagId);
  const activeFilters = [];
  if (settlement) activeFilters.push({ text: settlement === 'settled' ? '已结清' : '未结清', clear: { settlement: '', unpaid: '', page: null } });
  if (responsibleId) activeFilters.push({ text: '负责人：' + (selectedResponsible ? selectedResponsible.name : '账号不可用'), clear: { responsible_id: null, page: null } });
  if (customerId) activeFilters.push({ text: '客户：' + (selectedCustomer ? selectedCustomer.name : '客户不可用'), clear: { customer_id: null, page: null } });
  if (start || end) activeFilters.push({ text: '日期：' + (start || '不限') + ' 至 ' + (end || '不限'), clear: { start: '', end: '', page: null } });
  if (tagId) activeFilters.push({ text: '客户标签：' + (tagId === 'untagged' ? '无标签' : (selectedTag ? selectedTag.name : '标签不存在')), clear: { tag_id: null, page: null } });
  if (guestOnly) activeFilters.push({ text: '散客', clear: { guest: '', page: null } });
  if (pendingOnly) activeFilters.push({ text: '待审核', clear: { pending: '', page: null } });
  if (orderStatus) activeFilters.push({ text: orderStatus === 'approved' ? '已审核' : '草稿', clear: { status: '', page: null } });
%>
<details class="card sales-filter-panel" id="salesFilterPanel" open>
  <summary>筛选订单<% if (activeFilters.length) { %><span class="sales-filter-count"><%= activeFilters.length %></span><% } %></summary>
  <form method="GET" action="/sales" class="sales-filter-form">
    <div class="form-row sales-customer-filter">
      <label for="salesCustomerSearch">客户</label>
      <div class="customer-picker" id="salesCustomerPicker">
        <div class="customer-picker-control">
          <span class="customer-picker-icon" aria-hidden="true">⌕</span>
          <input id="salesCustomerSearch" class="customer-picker-search" type="search" placeholder="搜索名称、联系人、电话或地址" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="salesCustomerPickerResults" aria-autocomplete="list">
          <button type="button" id="clearSalesCustomer" class="customer-picker-clear" aria-label="清除已选客户" hidden>×</button>
        </div>
        <div id="salesCustomerPickerResults" class="customer-picker-results" role="listbox" hidden>
          <div id="salesCustomerSearchCount" class="customer-picker-result-summary">共 <%= customers.length %> 位客户</div>
          <button type="button" class="customer-picker-option" role="option" data-customer-id="" data-search="全部客户">
            <span class="customer-picker-name">全部客户</span>
          </button>
        <% customers.forEach(function(customer) { %>
          <button type="button" class="customer-picker-option" role="option" data-customer-id="<%= customer.id %>" data-search="<%= [customer.name, customer.contact, customer.phone, customer.address].filter(Boolean).join(' ').toLocaleLowerCase() %>">
            <span class="customer-picker-name"><%= customer.name %></span>
            <span class="customer-picker-meta"><%= [customer.contact, customer.phone, customer.address].filter(Boolean).join(' · ') || '未填写联系方式' %></span>
          </button>
        <% }) %>
          <p id="salesCustomerPickerEmpty" class="customer-picker-empty" hidden>没有匹配的客户</p>
        </div>
        <input type="hidden" name="customer_id" id="salesCustomerId" value="<%= customerId || '' %>">
      </div>
    </div>
    <fieldset class="form-row sales-settlement-filter">
      <legend>结清状态</legend>
      <div class="sales-settlement-segments">
        <% [['all', '全部'], ['outstanding', '未结清'], ['settled', '已结清']].forEach(function(option) { %>
          <label><input type="radio" name="settlement" value="<%= option[0] %>" <%= (settlement || 'all') === option[0] ? 'checked' : '' %>><span><%= option[1] %></span></label>
        <% }) %>
      </div>
      <select class="sales-settlement-select" id="salesSettlement" aria-label="结清状态" disabled>
        <option value="all" <%= !settlement ? 'selected' : '' %>>全部</option>
        <option value="outstanding" <%= settlement === 'outstanding' ? 'selected' : '' %>>未结清</option>
        <option value="settled" <%= settlement === 'settled' ? 'selected' : '' %>>已结清</option>
      </select>
    </fieldset>
    <div class="form-row sales-responsible-filter">
      <label for="salesResponsible">负责人</label>
      <% if (responsibleOptions.length > 8) { %><input type="search" id="salesResponsibleSearch" placeholder="搜索姓名或账号" aria-label="搜索负责人" class="sales-responsible-search"><% } %>
      <select id="salesResponsible" name="responsible_id">
        <option value="">全部负责人</option>
        <% if (responsibleId && !selectedResponsible) { %><option value="<%= responsibleId %>" selected>账号不可用</option><% } %>
        <% responsibleOptions.forEach(function(person) { %><option value="<%= person.id %>" <%= responsibleId === person.id ? 'selected' : '' %>><%= person.name %>（<%= person.username %>）<%= person.active ? '' : ' · 已停用' %></option><% }) %>
      </select>
      <span class="muted sales-responsible-search-empty" id="salesResponsibleSearchEmpty" hidden>没有匹配的负责人</span>
    </div>
    <details class="sales-more-filters" <%= start || end || tagId ? 'open' : '' %>>
      <summary>更多筛选<span>日期 / 客户标签</span></summary>
      <div class="sales-more-filter-fields">
        <div class="form-row"><label for="salesStart">开始日期</label><input id="salesStart" type="date" name="start" value="<%= start %>"></div>
        <div class="form-row"><label for="salesEnd">结束日期</label><input id="salesEnd" type="date" name="end" value="<%= end %>"></div>
        <div class="form-row sales-tag-filter"><label for="salesTagFilter">客户标签</label><select id="salesTagFilter" name="tag_id"><option value="">全部标签</option><option value="untagged" <%= tagId === 'untagged' ? 'selected' : '' %>>无标签</option><% tags.forEach(function(tag) { %><option value="<%= tag.id %>" <%= tagId === tag.id ? 'selected' : '' %>><%= tag.name %></option><% }) %></select></div>
      </div>
    </details>
    <p class="sales-filter-hint">结清状态按已审核订单计算；未结清包含欠款和待退款。</p>
    <% if (orderStatus) { %><input type="hidden" name="status" value="<%= orderStatus %>"><% } %>
    <% if (pendingOnly) { %><input type="hidden" name="pending" value="1"><% } %>
    <% if (guestOnly) { %><input type="hidden" name="guest" value="1"><% } %>
    <input type="hidden" name="sort" value="<%= sort %>"><input type="hidden" name="order" value="<%= order %>">
    <div class="sales-filter-actions">
      <button type="submit" class="btn">应用筛选</button>
      <a class="btn btn-secondary" href="/sales">重置</a>
      <a class="btn btn-secondary sales-export" href="/sales/export<%= salesQueryString({ page: null }) %>">导出CSV</a>
    </div>
  </form>
</details>
<% if (activeFilters.length) { %>
<div class="sales-active-filters" aria-label="已应用筛选">
  <% activeFilters.forEach(function(filter) { %><a aria-label="清除<%= filter.text %>筛选" href="/sales<%= salesQueryString(filter.clear) %>" class="sales-filter-chip"><%= filter.text %><span aria-hidden="true">×</span></a><% }) %>
  <a class="sales-clear-filters" href="/sales">清空筛选</a>
</div>
<% } %>
<% if (currentUser.role === 'admin') { %>
<details class="card customer-reassign sales-reassign-panel" id="salesReassignPanel">
  <summary>
    <span>更多管理 · 批量转移订单负责人</span>
    <span class="customer-reassign-hint">按人员交接欠款单或全部单据</span>
  </summary>
  <div class="customer-reassign-content">
    <p class="muted">人员换岗或离职交接时，可将某位负责人名下的<strong>未结清（欠款）订单</strong>或<strong>全部销售单</strong>一次性转给接手人；也可直接在下方列表勾选多张订单精准转移（原录入人仍保留查看权限）。</p>
    <form method="POST" action="/sales/reassign" class="sales-reassign-form" onsubmit="return confirm('确认按所选条件批量转移销售单负责人吗？')">
      <input type="hidden" name="return_to" value="/sales<%= salesQueryString({ page }) %>">
      <div class="form-row">
        <label for="salesReassignFrom">原负责人</label>
        <select id="salesReassignFrom" name="from_user_id" required>
          <option value="">-- 请选择原负责人 --</option>
          <% responsibleOptions.forEach(function(person) { %>
            <option value="<%= person.id %>" <%= responsibleId === person.id ? 'selected' : '' %>><%= person.name %>（<%= person.username %>）<%= person.active ? '' : ' · 已停用' %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-row">
        <label for="salesReassignScope">转移范围</label>
        <select id="salesReassignScope" name="scope">
          <option value="outstanding">仅未结清订单（欠款 / 待退）</option>
          <option value="all">该负责人名下全部销售单</option>
        </select>
      </div>
      <div class="form-row">
        <label for="salesReassignTo">转给新负责人</label>
        <select id="salesReassignTo" name="to_user_id" required>
          <option value="">-- 请选择接手人 --</option>
          <% responsibleOptions.filter(function(p) { return p.active; }).forEach(function(person) { %>
            <option value="<%= person.id %>"><%= person.name %>（<%= person.username %>）</option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn">一键批量转移</button>
    </form>
  </div>
</details>
<% } %>
<div class="sales-results-summary">共 <strong><%= totalOrders %></strong> 单<% if (activeFilters.length) { %> · 符合当前筛选<% } %></div>
<script>
  (function() {
    const panel = document.getElementById('salesFilterPanel');
    const mobile = window.matchMedia('(max-width: 768px)');
    const select = document.getElementById('salesSettlement');
    const radios = Array.from(document.querySelectorAll('input[name="settlement"]'));
    select.addEventListener('change', function() { radios.find(radio => radio.value === select.value).checked = true; });
    radios.forEach(function(radio) { radio.addEventListener('change', function() { select.value = radio.value; }); });
    const sync = function() {
      select.disabled = !mobile.matches;
      if (!mobile.matches) panel.open = true;
    };
    sync();
    const search = document.getElementById('salesResponsibleSearch');
    if (search) {
      const people = document.getElementById('salesResponsible');
      const options = Array.from(people.options);
      search.addEventListener('input', function() {
        const keyword = search.value.trim().toLocaleLowerCase();
        const selected = people.value;
        const matches = options.filter(option => !option.value || option.value === selected || option.textContent.toLocaleLowerCase().includes(keyword));
        people.replaceChildren(...matches);
        people.value = selected;
        document.getElementById('salesResponsibleSearchEmpty').hidden = options.some(option => option.value && option.textContent.toLocaleLowerCase().includes(keyword));
      });
    }
    if (window.matchMedia('(max-width: 768px)').matches) panel.open = false;
    window.addEventListener('resize', sync);
  })();
</script>
<div class="sales-mobile-sort" aria-label="销售订单排序">
  <span>排序：</span>
  <a class="btn btn-secondary btn-sm <%= sort === 'date' ? 'is-selected' : '' %>" href="/sales<%= salesQueryString({ start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: 'date', order: sort === 'date' && order === 'desc' ? 'asc' : 'desc' }) %>">日期<%= sort === 'date' ? (order === 'asc' ? ' ↑' : ' ↓') : '' %></a>
  <a class="btn btn-secondary btn-sm <%= sort === 'amount' ? 'is-selected' : '' %>" href="/sales<%= salesQueryString({ start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: 'amount', order: sort === 'amount' && order === 'desc' ? 'asc' : 'desc' }) %>">金额<%= sort === 'amount' ? (order === 'asc' ? ' ↑' : ' ↓') : '' %></a>
  <a class="btn btn-secondary btn-sm <%= sort === 'debt' ? 'is-selected' : '' %>" href="/sales<%= salesQueryString({ start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: 'debt', order: sort === 'debt' && order === 'desc' ? 'asc' : 'desc' }) %>">欠款<%= sort === 'debt' ? (order === 'asc' ? ' ↑' : ' ↓') : '' %></a>
</div>
<% if (currentUser.role === 'admin' && orders.length > 0) { %>
<form method="POST" action="/sales/batch-responsible" id="salesBatchTransferForm" class="card sales-batch-bar">
  <input type="hidden" name="return_to" value="/sales<%= salesQueryString({ page }) %>">
  <input type="hidden" name="order_ids" id="salesBatchOrderIds" value="">
  <div class="sales-batch-left">
    <label class="sales-batch-select-all" for="salesSelectAll">
      <input type="checkbox" id="salesSelectAll">
      <span>全选本页</span>
    </label>
    <span class="sales-batch-count" id="salesBatchCount" aria-live="polite">已选 0 单</span>
  </div>
  <div class="sales-batch-right">
    <label for="salesBatchToUser" class="sales-batch-label">转移负责人给</label>
    <select id="salesBatchToUser" name="to_user_id" required>
      <option value="">-- 请选择接手人 --</option>
      <% responsibleOptions.filter(function(p) { return p.active; }).forEach(function(person) { %>
        <option value="<%= person.id %>"><%= person.name %>（<%= person.username %>）</option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-sm" id="salesBatchSubmitBtn">转移所选订单</button>
  </div>
</form>
<% } %>
<div class="card desktop-table-wrap sales-orders-table-wrap">
  <table class="<%= currentUser.role === 'admin' ? 'sales-selectable-table' : '' %>">
    <tr>
      <% if (currentUser.role === 'admin') { %><th class="sales-select-col"><input type="checkbox" id="salesSelectAllTable" aria-label="全选本页销售单"></th><% } %>
      <th>单号</th><th><a href="/sales<%= salesQueryString({ start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: 'date', order: sort === 'date' && order === 'desc' ? 'asc' : 'desc' }) %>" class="table-sort">日期<%= sort === 'date' ? (order === 'asc' ? ' ↑' : ' ↓') : '' %></a></th><th>客户</th><th>仓库</th><th><a href="/sales<%= salesQueryString({ start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: 'amount', order: sort === 'amount' && order === 'desc' ? 'asc' : 'desc' }) %>" class="table-sort">金额<%= sort === 'amount' ? (order === 'asc' ? ' ↑' : ' ↓') : '' %></a></th><th>已收款</th><th><a href="/sales<%= salesQueryString({ start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: 'debt', order: sort === 'debt' && order === 'desc' ? 'asc' : 'desc' }) %>" class="table-sort">欠款<%= sort === 'debt' ? (order === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
      <th>收款状态</th><th>审核状态</th><th>负责人</th><th>操作</th>
    </tr>
    <% orders.forEach(function(o) { %>
      <tr data-order-row="<%= o.id %>">
        <% if (currentUser.role === 'admin') { %><td class="sales-select-col"><input type="checkbox" class="sales-order-checkbox" data-order-id="<%= o.id %>" value="<%= o.id %>" aria-label="选择销售单 #<%= o.id %>"></td><% } %>
        <td><a href="/sales/<%= o.id %>">#<%= o.id %></a></td>
        <td><%= o.order_date %><br><span class="muted">录入 <%= formatDateTime(o.created_at).slice(0, 16) %></span></td>
        <td><%= o.customer_name || '散客' %></td>
        <td><%= o.warehouse_name %></td>
        <td>¥<%= o.total_amount.toFixed(1) %></td>
        <td>¥<%= (o.paid_amount || 0).toFixed(1) %></td>
        <td><% if (o.status === 'approved') { %>¥<%= o.effective_debt.toFixed(1) %><% if (o.pending_refund > 0) { %><span class="detail-owing">待退 ¥<%= o.pending_refund.toFixed(1) %></span><% } %><% if (o.returned_amount > 0) { %><span class="muted" style="font-size:11px">（退货¥<%= o.returned_amount.toFixed(1) %>，已退现金¥<%= o.cash_refunded_amount.toFixed(1) %>）</span><% } %><% } else { %><span class="muted">审核后生效</span><% } %></td>
        <td>
          <%- include('partials/payment_status', { order: o }) %>
        </td>
        <td>
          <%- include('partials/order_status', { status: o.status }) %>
        </td>
        <td><%= o.responsible_name %></td>
        <td>
          <a href="/sales/<%= o.id %>" class="btn btn-sm btn-secondary">详情</a>
          <% if (o.status === 'draft' && (currentUser.role === 'admin' || o.user_id === currentUser.id)) { %>
            <form action="/sales/<%= o.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('确认删除这张未提交的草稿销售单？删除后无法恢复。')">
              <button type="submit" class="btn btn-sm btn-danger">删除</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table>
</div>
<% if (orders.length === 0) { %>
  <div class="card sales-empty-state">
    <strong><%= selectedCustomer ? selectedCustomer.name + '还没有符合条件的销售订单' : '没有符合条件的订单' %></strong>
    <span><%= selectedCustomer ? '可以直接为这位客户新开一单。' : '试试调整筛选条件，或新建一张销售单。' %></span>
    <% if (activeFilters.length) { %><a class="btn btn-secondary btn-sm" href="/sales">清空筛选</a><% } %>
    <a class="btn btn-sm" href="/sales/new<%= selectedCustomer ? '?customer_id=' + selectedCustomer.id : '' %>">+ 新开单</a>
  </div>
<% } %>

<% if (totalPages > 1) { %>
<div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap">
  <span class="muted">共 <%= totalOrders %> 单，第 <%= page %> / <%= totalPages %> 页</span>
  <div style="display:flex; gap:8px">
    <% if (page > 1) { %>
      <a class="btn btn-secondary btn-sm" href="/sales<%= salesQueryString({ page: page - 1, start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: sort, order: order }) %>">上一页</a>
    <% } %>
    <% if (page < totalPages) { %>
      <a class="btn btn-secondary btn-sm" href="/sales<%= salesQueryString({ page: page + 1, start: start, end: end, customer_id: customerId, guest: guestOnly ? 1 : '', pending: pendingOnly ? 1 : '', sort: sort, order: order }) %>">下一页</a>
    <% } %>
  </div>
</div>
<% } %>

<div class="mobile-order-cards">
  <% orders.forEach(function(o) { %>
    <div class="mobile-order-item" data-order-row="<%= o.id %>">
      <% if (currentUser.role === 'admin') { %>
        <label class="mobile-order-select">
          <input type="checkbox" class="sales-order-checkbox" data-order-id="<%= o.id %>" value="<%= o.id %>" aria-label="选择销售单 #<%= o.id %>（<%= o.customer_name || '散客' %>）">
          <span class="mobile-order-select-title">勾选 #<%= o.id %></span>
          <span class="mobile-order-select-meta">负责人：<%= o.responsible_name %></span>
        </label>
      <% } %>
      <a href="/sales/<%= o.id %>" class="order-card">
        <div class="order-card-top">
          <span class="order-card-id"><%= o.customer_name || '散客' %></span>
          <%- include('partials/order_status', { status: o.status }) %>
        </div>
        <div class="order-card-mid">
          <span>销售单 #<%= o.id %> · <%= o.order_date %></span>
          <span><%= o.warehouse_name %></span>
        </div>
        <div class="order-card-responsible">负责人：<%= o.responsible_name %></div>
        <div class="order-card-bottom">
          <span class="order-card-amount"><small>订单金额</small>¥<%= o.total_amount.toFixed(1) %></span>
          <%- include('partials/payment_status', { order: o }) %>
        </div>
        <% if (o.status === 'approved' && o.pending_refund > 0) { %><div class="order-card-debt">待退现金 ¥<%= o.pending_refund.toFixed(1) %></div><% } %>
        <% if (o.status === 'approved' && o.effective_debt > 0) { %>
          <div class="order-card-debt">欠款 ¥<%= o.effective_debt.toFixed(1) %></div>
        <% } %>
      </a>
      <% if (o.status === 'draft' && (currentUser.role === 'admin' || o.user_id === currentUser.id)) { %>
        <div class="draft-row-actions"><a class="btn btn-secondary btn-sm" href="/sales/<%= o.id %>/edit">继续编辑草稿</a>
        <form action="/sales/<%= o.id %>/delete" method="POST" onsubmit="return confirm('确认删除这张未提交的草稿销售单？删除后无法恢复。')">
          <button type="submit" class="btn btn-sm btn-danger">删除草稿</button>
        </form></div>
      <% } %>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>
<script>
  // 与新建销售单共用同一种客户选择体验：输入、结果与最终提交值始终来自同一组件。
  const salesCustomerSearch = document.getElementById('salesCustomerSearch');
  const salesCustomerPicker = document.getElementById('salesCustomerPicker');
  const salesCustomerResults = document.getElementById('salesCustomerPickerResults');
  const salesCustomerId = document.getElementById('salesCustomerId');
  const salesCustomerSearchCount = document.getElementById('salesCustomerSearchCount');
  const salesCustomerEmpty = document.getElementById('salesCustomerPickerEmpty');
  const clearSalesCustomer = document.getElementById('clearSalesCustomer');
  let salesCustomerOptions = Array.from(salesCustomerPicker.querySelectorAll('.customer-picker-option'));
  let activeSalesCustomerOption = -1;

  function selectedSalesCustomerOption() {
    return salesCustomerOptions.find(function(option) { return option.dataset.customerId === salesCustomerId.value; });
  }

  function salesCustomerLabel(option) {
    return option ? option.querySelector('.customer-picker-name').textContent.trim() : '';
  }

  let salesCustomerRevision = 0;
  async function filterSalesCustomers() {
    const selected = selectedSalesCustomerOption();
    const rawKeyword = salesCustomerSearch.value.trim().toLocaleLowerCase();
    const keyword = selected && rawKeyword === salesCustomerLabel(selected).toLocaleLowerCase() ? '' : rawKeyword;
    const revision = ++salesCustomerRevision;
    try {
      const response = await fetch('/order-options/customers?' + new URLSearchParams({q: keyword, order_id: ''}), {cache: 'no-store'});
      if (!response.ok) throw new Error();
      const data = await response.json();
      if (revision !== salesCustomerRevision || salesCustomerResults.hidden) return;
      const preserved = salesCustomerOptions.filter(option => !option.dataset.customerId || option.dataset.customerId === salesCustomerId.value);
      salesCustomerOptions.filter(option => !preserved.includes(option)).forEach(option => option.remove());
      for (const customer of data.customers) {
        if (preserved.some(option => option.dataset.customerId === String(customer.id))) continue;
        const option = document.createElement('button'); option.type = 'button'; option.className = 'customer-picker-option'; option.setAttribute('role', 'option');
        option.dataset.customerId = String(customer.id); option.dataset.search = [customer.name,customer.contact,customer.phone,customer.address].filter(Boolean).join(' ').toLocaleLowerCase();
        const name = document.createElement('span'); name.className = 'customer-picker-name'; name.textContent = customer.name;
        const meta = document.createElement('span'); meta.className = 'customer-picker-meta'; meta.textContent = [customer.contact,customer.phone,customer.address].filter(Boolean).join(' · ');
        option.append(name,meta); salesCustomerEmpty.before(option); preserved.push(option);
      }
      salesCustomerOptions = preserved;
    } catch (_) { salesCustomerSearchCount.textContent = '搜索暂不可用，请稍后重试'; return; }
    let matched = 0;
    salesCustomerOptions.forEach(function(option) {
      const visible = !keyword || option.dataset.search.includes(keyword);
      option.hidden = !visible;
      if (visible) matched++;
    });
    salesCustomerEmpty.hidden = matched > 0;
    salesCustomerSearchCount.textContent = keyword ? `匹配 ${matched} 位客户` : `最近 ${salesCustomerOptions.length - 1} 位客户，输入文字搜索`;
    activeSalesCustomerOption = -1;
  }

  function openSalesCustomerPicker() {
    salesCustomerResults.hidden = false;
    salesCustomerSearch.setAttribute('aria-expanded', 'true');
    filterSalesCustomers();
  }

  function closeSalesCustomerPicker() {
    salesCustomerResults.hidden = true;
    salesCustomerSearch.setAttribute('aria-expanded', 'false');
    activeSalesCustomerOption = -1;
    salesCustomerOptions.forEach(function(option) { option.classList.remove('active'); });
  }

  function selectSalesCustomer(option) {
    salesCustomerSearch.setCustomValidity('');
    salesCustomerId.value = option.dataset.customerId;
    salesCustomerSearch.value = salesCustomerLabel(option);
    clearSalesCustomer.hidden = !salesCustomerId.value;
    salesCustomerOptions.forEach(function(item) { item.setAttribute('aria-selected', item === option ? 'true' : 'false'); });
    closeSalesCustomerPicker();
  }

  salesCustomerSearch.addEventListener('focus', function() {
    openSalesCustomerPicker();
    if (salesCustomerId.value) salesCustomerSearch.select();
  });
  salesCustomerSearch.addEventListener('input', function() {
    salesCustomerId.value = '';
    clearSalesCustomer.hidden = !salesCustomerSearch.value;
    salesCustomerOptions.forEach(function(option) { option.setAttribute('aria-selected', 'false'); });
    salesCustomerSearch.setCustomValidity(salesCustomerSearch.value.trim() ? '请从搜索结果中选择客户，或清空搜索查看全部客户。' : '');
    openSalesCustomerPicker();
  });
  salesCustomerSearch.addEventListener('keydown', function(event) {
    const visibleOptions = salesCustomerOptions.filter(function(option) { return !option.hidden; });
    if (event.key === 'Escape') {
      closeSalesCustomerPicker();
      salesCustomerSearch.blur();
      return;
    }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (!visibleOptions.length) return;
      activeSalesCustomerOption = event.key === 'ArrowDown'
        ? Math.min(activeSalesCustomerOption + 1, visibleOptions.length - 1)
        : Math.max(activeSalesCustomerOption - 1, 0);
      visibleOptions.forEach(function(option, index) { option.classList.toggle('active', index === activeSalesCustomerOption); });
      visibleOptions[activeSalesCustomerOption].scrollIntoView({ block: 'nearest' });
      return;
    }
    if (event.key === 'Enter') {
      event.preventDefault();
      const exactMatches = visibleOptions.filter(function(item) { return salesCustomerLabel(item) === salesCustomerSearch.value.trim(); });
      const option = activeSalesCustomerOption >= 0 ? visibleOptions[activeSalesCustomerOption]
        : exactMatches.length === 1 ? exactMatches[0] : visibleOptions.length === 1 ? visibleOptions[0] : null;
      if (option) selectSalesCustomer(option);
    }
  });
  salesCustomerResults.addEventListener('click', function(event) { const option = event.target.closest('.customer-picker-option'); if (option) selectSalesCustomer(option); });
  clearSalesCustomer.addEventListener('click', function() {
    salesCustomerId.value = '';
    salesCustomerSearch.value = '';
    salesCustomerSearch.setCustomValidity('');
    clearSalesCustomer.hidden = true;
    salesCustomerOptions.forEach(function(option) { option.setAttribute('aria-selected', 'false'); });
    openSalesCustomerPicker();
    salesCustomerSearch.focus();
  });
  document.addEventListener('click', function(event) {
    if (!salesCustomerPicker.contains(event.target)) closeSalesCustomerPicker();
  });

  const initialSalesCustomer = selectedSalesCustomerOption();
  if (initialSalesCustomer && salesCustomerId.value) {
    salesCustomerSearch.value = salesCustomerLabel(initialSalesCustomer);
    clearSalesCustomer.hidden = false;
    initialSalesCustomer.setAttribute('aria-selected', 'true');
  }
  document.querySelector('.sales-filter-form').addEventListener('submit', function(event) {
    if (document.activeElement !== salesCustomerSearch) return;
    event.preventDefault();
    openSalesCustomerPicker();
    salesCustomerSearch.reportValidity();
  });

  // 批量勾选转移销售单负责人（桌面表格与手机卡片双向同步）
  (function() {
    const batchForm = document.getElementById('salesBatchTransferForm');
    if (!batchForm) return;
    const selectAllTop = document.getElementById('salesSelectAll');
    const selectAllTable = document.getElementById('salesSelectAllTable');
    const orderIdsInput = document.getElementById('salesBatchOrderIds');
    const batchCountEl = document.getElementById('salesBatchCount');
    const batchToSelect = document.getElementById('salesBatchToUser');
    const checkboxes = Array.from(document.querySelectorAll('.sales-order-checkbox'));
    const uniqueOrderIds = Array.from(new Set(checkboxes.map(function(cb) { return cb.dataset.orderId; })));

    function syncBatchState() {
      const selectedSet = new Set();
      checkboxes.forEach(function(cb) {
        if (cb.checked) selectedSet.add(cb.dataset.orderId);
      });
      const selectedList = Array.from(selectedSet);
      orderIdsInput.value = selectedList.join(',');
      batchCountEl.textContent = '已选 ' + selectedList.length + ' 单';
      batchForm.classList.toggle('has-selection', selectedList.length > 0);

      document.querySelectorAll('[data-order-row]').forEach(function(row) {
        row.classList.toggle('is-selected', selectedSet.has(row.getAttribute('data-order-row')));
      });

      const allChecked = uniqueOrderIds.length > 0 && selectedList.length === uniqueOrderIds.length;
      const someChecked = selectedList.length > 0 && selectedList.length < uniqueOrderIds.length;
      [selectAllTop, selectAllTable].forEach(function(master) {
        if (!master) return;
        master.checked = allChecked;
        master.indeterminate = someChecked;
        if (selectedList.length > 0) master.setCustomValidity('');
      });
    }

    checkboxes.forEach(function(cb) {
      cb.addEventListener('change', function() {
        const orderId = cb.dataset.orderId;
        const checked = cb.checked;
        checkboxes.forEach(function(peer) {
          if (peer.dataset.orderId === orderId) peer.checked = checked;
        });
        syncBatchState();
      });
    });

    [selectAllTop, selectAllTable].forEach(function(master) {
      if (!master) return;
      master.addEventListener('change', function() {
        const checked = master.checked;
        checkboxes.forEach(function(cb) { cb.checked = checked; });
        syncBatchState();
      });
    });

    batchForm.addEventListener('submit', function(event) {
      const selectedIds = orderIdsInput.value ? orderIdsInput.value.split(',').filter(Boolean) : [];
      if (selectedIds.length === 0) {
        event.preventDefault();
        if (selectAllTop) {
          selectAllTop.setCustomValidity('请先在列表中勾选至少一张要转移的销售单');
          selectAllTop.reportValidity();
        }
        return;
      }
      if (!batchToSelect.value) return;
      const targetText = batchToSelect.options[batchToSelect.selectedIndex].textContent.trim();
      if (!window.confirm('确认将已勾选的 ' + selectedIds.length + ' 张销售单转移给【' + targetText + '】吗？')) {
        event.preventDefault();
      }
    });
  })();
</script>
