<%- include('partials/header') %>
<h1><%= product && product.id ? '编辑商品' : '新增商品' %></h1>
<div class="card" style="max-width:520px">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="<%= product && product.id ? '/products/' + product.id + '/edit' : '/products/new' %>">
    <div class="grid-2">
      <div class="form-row">
        <label>SKU（可选）</label>
        <input type="text" name="sku" value="<%= product ? (product.sku || '') : '' %>">
      </div>
      <div class="form-row">
        <label>商品名称 *</label>
        <input type="text" name="name" required value="<%= product ? (product.name || '') : '' %>">
      </div>
    </div>
    <div class="grid-2">
      <div class="form-row">
        <label>规格</label>
        <input type="text" name="spec" value="<%= product ? (product.spec || '') : '' %>">
      </div>
      <div class="form-row">
        <label>基本单位 *（库存以此单位计数，比如"瓶"）</label>
        <input type="text" name="unit" required value="<%= product ? (product.unit || '瓶') : '瓶' %>">
      </div>
    </div>
    <div class="grid-2">
      <div class="form-row">
        <label>大单位（可选，比如"箱"，不填则只用基本单位）</label>
        <input type="text" name="pack_unit" value="<%= product && product.pack_unit ? product.pack_unit : '' %>">
      </div>
      <div class="form-row">
        <label>换算比例（1个大单位 = 几个基本单位，比如1箱=24瓶）</label>
        <input type="number" name="pack_size" min="1" value="<%= product ? (product.pack_size || 1) : 1 %>">
      </div>
    </div>
    <p class="muted">举例：基本单位填"瓶"，大单位填"箱"，换算比例填 24，表示 1 箱 = 24 瓶。库存内部统一按"瓶"计数，采购/销售/调拨时可以直接按"箱"整箱录入，系统自动换算。</p>

    <div class="grid-2" id="pack-price-row">
      <div class="form-row">
        <label>箱成本价（按<span class="pack-unit-label">箱</span>，常用，精确录入）</label>
        <input type="number" step="0.01" name="cost_price_pack" id="cost_price_pack"
               value="<%= product && product.cost_price_pack !== null && product.cost_price_pack !== undefined ? product.cost_price_pack : '' %>">
      </div>
      <div class="form-row">
        <label>箱销售价（按<span class="pack-unit-label">箱</span>，常用，精确录入）</label>
        <input type="number" step="0.01" name="sale_price_pack" id="sale_price_pack"
               value="<%= product && product.sale_price_pack !== null && product.sale_price_pack !== undefined ? product.sale_price_pack : '' %>">
      </div>
    </div>
    <p class="muted" id="pack-price-hint">整箱下单（采购/销售/退货）时，会优先使用这里填写的箱价，不再用瓶价乘换算比例反算，避免除不尽产生的误差（例如 380 元/箱、24瓶一箱，瓶价四舍五入后乘回24会变成380.04）。</p>

    <div class="grid-3">
      <div class="form-row">
        <label>瓶成本价（按基本单位，仅拆零零卖用，允许有小数误差）</label>
        <input type="number" step="0.01" name="cost_price" id="cost_price" value="<%= product ? (product.cost_price || 0) : 0 %>">
      </div>
      <div class="form-row">
        <label>瓶售价（按基本单位，仅拆零零卖用，允许有小数误差）</label>
        <input type="number" step="0.01" name="sale_price" id="sale_price" value="<%= product ? (product.sale_price || 0) : 0 %>">
      </div>
      <div class="form-row">
        <label>库存预警阈值</label>
        <input type="number" name="low_stock_threshold" value="<%= product ? (product.low_stock_threshold || 0) : 0 %>">
      </div>
    </div>

    <script>
      // 辅助：填了箱价没填瓶价时，自动按换算比例估算一个瓶价（仅作参考，可手动修改，不影响箱价的精确存储）
      (function() {
        const packSizeInput = document.querySelector('input[name=pack_size]');
        const packUnitInput = document.querySelector('input[name=pack_unit]');
        const costPack = document.getElementById('cost_price_pack');
        const salePack = document.getElementById('sale_price_pack');
        const costBase = document.getElementById('cost_price');
        const saleBase = document.getElementById('sale_price');

        function fillLabel() {
          const u = (packUnitInput.value || '箱').trim();
          document.querySelectorAll('.pack-unit-label').forEach(el => el.textContent = u || '箱');
        }
        packUnitInput.addEventListener('input', fillLabel);
        fillLabel();

        function suggestBase(packInput, baseInput) {
          const packSize = Number(packSizeInput.value) || 1;
          const packVal = Number(packInput.value);
          if (packVal && (!baseInput.value || Number(baseInput.value) === 0)) {
            baseInput.value = (packVal / packSize).toFixed(2);
          }
        }
        costPack.addEventListener('change', () => suggestBase(costPack, costBase));
        salePack.addEventListener('change', () => suggestBase(salePack, saleBase));
      })();
    </script>
    <button class="btn" type="submit">保存</button>
    <a class="btn btn-secondary" href="/products">取消</a>
  </form>
</div>
<%- include('partials/footer') %>
