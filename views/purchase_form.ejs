<%- include('partials/header') %>
<% const form = typeof formValues !== 'undefined' && formValues ? formValues : {}; %>
<h1>新建采购单</h1>
<div class="card">
  <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
  <form method="POST" action="/purchases/new" id="purchaseForm" data-order-draft="purchases">
    <input type="hidden" name="_request_key" value="<%= typeof formValues !== 'undefined' && formValues && formValues._request_key ? formValues._request_key : newRequestKey() %>">
    <div class="grid-3">
      <div class="form-row">
        <label>供应商（可选）</label>
        <select name="supplier_id">
          <option value="">-- 无 --</option>
          <% suppliers.forEach(function(s) { %><option value="<%= s.id %>" <%= String(form.supplier_id || '') === String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %>
        </select>
      </div>
      <div class="form-row">
        <label>入库仓库 *</label>
        <select name="warehouse_id" required>
          <% warehouses.forEach(function(w) { %><option value="<%= w.id %>" <%= String(form.warehouse_id || '') === String(w.id) ? 'selected' : '' %>><%= w.name %></option><% }) %>
        </select>
      </div>
      <div class="form-row">
        <label>日期</label>
        <input type="date" name="order_date" value="<%= form.order_date || today %>">
      </div>
    </div>

    <h2 class="form-section-heading">商品明细</h2>
    <div id="items"></div>
    <button type="button" class="btn btn-secondary btn-sm" onclick="addRow()">+ 添加一行</button>

    <p><strong>商品合计：¥<span id="itemsTotal">0.00</span></strong></p>
    <div class="form-row" style="margin-top:16px">
      <label>备注</label>
      <textarea name="note" rows="2"><%= form.note || '' %></textarea>
    </div>

    <div class="form-actions sale-form-actions">
      <button class="btn" type="submit">提交入库</button>
      <a class="btn btn-secondary" href="/purchases">取消</a>
    </div>
  </form>
</div>

<div class="sale-mobile-submit" aria-label="单据操作"><div><small>商品合计</small><strong>¥<span id="stickyItemsTotal">0.00</span></strong></div><button class="btn" type="submit" form="purchaseForm">提交入库</button></div>
<script>
  const PRODUCTS = <%- JSON.stringify(products).replace(/</g, '\\u003c') %>;
  let rowIndex = 0;

  // HTML 转义：商品名/规格/单位是自由文本，经 innerHTML 拼 <option> 时
  // 若含 < > 引号会破坏 DOM 结构甚至注入脚本
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function addRow(initial) {
    const container = document.getElementById('items');
    const div = document.createElement('div');
    div.className = 'item-row';
    div.style.gridTemplateColumns = '2fr 1fr 1fr 1fr auto';
    const options = PRODUCTS.map(p => `<option value="${p.id}" data-search="${esc([p.name, p.sku, p.spec].filter(Boolean).join(' '))}" data-name="${esc(p.name)}" data-sku="${esc(p.sku || '')}" data-price="${p.cost_price}" data-price-pack="${p.cost_price_pack != null ? p.cost_price_pack : ''}" data-unit="${esc(p.unit)}" data-pack-unit="${esc(p.pack_unit || '')}" data-pack-size="${p.pack_size || 1}">${esc(p.name)}${p.spec ? ' ('+esc(p.spec)+')' : ''}</option>`).join('');
    div.innerHTML = `
      <input type="search" class="product-search" aria-label="搜索商品" autocomplete="off">
      <select name="product_id" aria-label="商品" onchange="onProductChange(this)" required>
        <option value="">-- 选择商品 --</option>
        ${options}
      </select>
      <select name="unit_choice" class="unit-select" onchange="fillPrice(this.closest('.item-row').querySelector('select[name=product_id]'))">
        <option value="base">（先选商品）</option>
      </select>
      <input type="number" name="quantity" placeholder="数量" min="1" required>
      <input type="number" name="unit_price" placeholder="采购单价" step="0.01" required>
      <button type="button" class="btn btn-danger btn-sm" onclick="this.parentElement.remove()">删除</button>
    `;
    container.appendChild(div);
    if (initial) {
      const select = div.querySelector('[name="product_id"]'); select.value = initial.id;
      if (select.value) onProductChange(select);
      div.querySelector('[name="unit_choice"]').value = initial.unit_choice;
      div.querySelector('[name="quantity"]').value = initial.quantity;
      div.querySelector('[name="unit_price"]').value = initial.price;
    }
  }

  function onProductChange(select) {
    const row = select.parentElement;
    const opt = select.options[select.selectedIndex];
    const unit = opt.getAttribute('data-unit');
    const packUnit = opt.getAttribute('data-pack-unit');
    const unitSelect = row.querySelector('select[name=unit_choice]');
    unitSelect.innerHTML = '';
    const baseOpt = document.createElement('option');
    baseOpt.value = 'base';
    baseOpt.textContent = unit || '基本单位';
    unitSelect.appendChild(baseOpt);
    if (packUnit) {
      const packOpt = document.createElement('option');
      packOpt.value = 'pack';
      packOpt.textContent = packUnit;
      unitSelect.appendChild(packOpt);
    }
    fillPrice(select);
  }

  function fillPrice(select) {
    const row = select.parentElement;
    const opt = select.options[select.selectedIndex];
    const basePrice = Number(opt.getAttribute('data-price')) || 0;
    const packPriceRaw = opt.getAttribute('data-price-pack');
    const packPrice = packPriceRaw !== null && packPriceRaw !== '' ? Number(packPriceRaw) : null;
    const packSize = Number(opt.getAttribute('data-pack-size')) || 1;
    const unitChoice = row.querySelector('select[name=unit_choice]').value;
    const priceInput = row.querySelector('input[name=unit_price]');
    const suggested = unitChoice === 'pack' ? (packPrice != null ? packPrice : basePrice * packSize) : basePrice;
    priceInput.value = suggested || '';
  }

  const INITIAL_ITEMS = <%- JSON.stringify(typeof draftItems !== 'undefined' ? draftItems : []).replace(/</g, '\\u003c') %>;
  if (INITIAL_ITEMS.length) INITIAL_ITEMS.forEach(addRow); else addRow();
</script>
<%- include('partials/footer') %>
