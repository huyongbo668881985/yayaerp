<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>鸭鸭进销存</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/csrf.js" defer></script>

  <!-- PWA：添加到主屏幕 -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2f6feb">

  <!-- 通用 favicon -->
  <link rel="icon" type="image/png" href="/favicon.png">

  <!-- Android / Chrome 添加到主屏幕图标 -->
  <link rel="icon" sizes="192x192" href="/icons/icon-192.png">
  <link rel="icon" sizes="512x512" href="/icons/icon-512.png">

  <!-- iOS Safari 不读取 manifest.json，必须单独声明 -->
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="鸭鸭进销存">
</head>
<body>
<% if (currentUser) { %>
<div class="topbar">
  <div class="brand">
    🦆 鸭鸭进销存<% if (currentTenant) { %> · <%= currentTenant.name %><% } %>
  </div>
  <button class="nav-toggle" id="navToggle" aria-label="菜单" onclick="document.getElementById('mainNav').classList.toggle('open')">☰</button>
  <nav id="mainNav">
    <a href="/">首页</a>
    <a href="/sales">销售退货</a>
    <a href="/inventory">库存</a>
    <a href="/customers">客户</a>
    <a href="/transfers">调拨</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/purchases">采购</a>
      <a href="/reports">经营报表</a>
    <% } %>
    <a href="/products">基础信息</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/users">账号</a>
    <% } %>
    <div class="nav-userbox">
      <span><%= currentUser.name %>（<%= currentUser.role === 'admin' ? '管理员' : '操作员' %>）</span>
      <a href="/change-password">修改密码</a>
      <form method="POST" action="/logout"><button class="btn btn-secondary btn-sm" type="submit">退出</button></form>
    </div>
  </nav>
  <div class="userbox">
    <span><%= currentUser.name %> (<%= currentUser.role === 'admin' ? '管理员' : '操作员' %>)</span>
    <a href="/change-password">修改密码</a>
    <form method="POST" action="/logout"><button class="btn btn-secondary btn-sm" type="submit">退出</button></form>
  </div>
</div>
<% } %>
<div class="container">
<% if (currentUser) { %>
  <div class="mobile-quick-actions">
    <a href="/sales/new" class="btn">+ 销售出库</a>
    <a href="/transfers/new" class="btn btn-secondary">+ 调拨</a>
    <a href="/inventory" class="btn btn-secondary">查库存</a>
  </div>
<% } %>
