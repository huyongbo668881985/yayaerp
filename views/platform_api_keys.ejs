<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>平台管理 - API Key 管理</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/csrf.js" defer></script>
</head>
<body>
<div class="topbar">
  <div class="brand">🛠 平台管理后台</div>
  <div class="userbox">
    <span><%= currentPlatformAdmin.name %></span>
    <a href="/platform-admin" class="btn btn-secondary btn-sm">租户列表</a>
    <a href="/platform-admin/audit-log" class="btn btn-secondary btn-sm">审计日志</a>
    <a href="/platform-admin/change-password" class="btn btn-secondary btn-sm">修改密码</a>
    <form method="POST" action="/platform-admin/logout"><button class="btn btn-secondary btn-sm" type="submit">退出</button></form>
  </div>
</div>
<div class="container">
  <h1>API Key 管理</h1>

  <div class="card">
    <p class="muted" style="margin-top:0">
      这里生成的 Key 用于 <code>/api/v1</code> 独立 REST API（供 n8n、Codex 等自动化工具调用），请求时放在
      <code>Authorization: Bearer &lt;key&gt;</code> 或 <code>X-API-Key</code> 请求头里。<br>
      权限三档：只读 / 读+写 / 最大权限。<b>当前版本只开放"只读"档位对应的查询端点</b>，
      读+写、最大权限为未来开放写接口预留，现在选中也不会有对应端点。<br>
      所有生成、吊销、改档位操作都会记入<a href="/platform-admin/audit-log">审计日志</a>。
    </p>

    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <% if (newKey) { %>
      <div style="background:#fef9c3; border:1px solid #f59e0b; border-radius:8px; padding:14px; margin-bottom:16px">
        <p style="margin:0 0 8px; font-weight:700">✅ Key 已生成，请立即复制——关闭本页面后明文无法再次查看！</p>
        <code style="font-size:16px; word-break:break-all; user-select:all"><%= newKey.plaintext %></code>
        <p class="muted" style="margin:8px 0 0">租户：<%= newKey.tenantName %> ｜ 档位：<%= levelLabels[newKey.permissionLevel] %> ｜ 系统里只保存哈希，丢失只能吊销后重新生成。</p>
      </div>
    <% } %>

    <h2>生成新 Key</h2>
    <form method="POST" action="/platform-admin/api-keys/generate">
      <div class="grid-2">
        <div class="form-row">
          <label>租户</label>
          <select name="tenant_id" required>
            <option value="">— 选择租户 —</option>
            <% tenants.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= filterTenantId === t.id ? 'selected' : '' %>>
                <%= t.name %>（<%= t.tenant_code %><%= t.status !== 'active' ? '，已暂停' : '' %>）
              </option>
            <% }) %>
          </select>
        </div>
        <div class="form-row">
          <label>权限档位</label>
          <select name="permission_level" required>
            <option value="read_only" selected>只读（当前唯一开放的档位）</option>
            <option value="read_write">读+写（预留，暂无对应端点）</option>
            <option value="full">最大权限（预留，暂无对应端点）</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn">生成新 API Key</button>
    </form>
  </div>

  <div class="card">
    <h2>Key 列表</h2>
    <form method="GET" action="/platform-admin/api-keys" style="margin-bottom:12px; max-width:320px">
      <select name="tenant_id" onchange="this.form.submit()">
        <option value="">全部租户</option>
        <% tenants.forEach(function(t) { %>
          <option value="<%= t.id %>" <%= filterTenantId === t.id ? 'selected' : '' %>><%= t.name %>（<%= t.tenant_code %>）</option>
        <% }) %>
      </select>
    </form>

    <div class="desktop-table-wrap">
      <table>
        <tr><th>租户</th><th>Key 前缀</th><th>档位</th><th>状态</th><th>创建</th><th>最近使用</th><th>改档位</th><th>操作</th></tr>
        <% keys.forEach(function(k) { %>
          <tr>
            <td><%= k.tenant_name %>（<%= k.tenant_code %>）</td>
            <td><code><%= k.key_prefix %>…</code></td>
            <td><%= levelLabels[k.permission_level] %></td>
            <td>
              <% if (k.revoked_at) { %>
                <span class="badge badge-low">已吊销 <%= k.revoked_at %></span>
              <% } else { %>
                <span class="badge badge-operator">启用中</span>
              <% } %>
            </td>
            <td><%= k.created_at %><br><span class="muted">by <%= k.created_by_username %></span></td>
            <td><%= k.last_used_at || '从未使用' %></td>
            <td>
              <% if (!k.revoked_at) { %>
                <form method="POST" action="/platform-admin/api-keys/<%= k.id %>/tier" style="display:flex; gap:6px" onsubmit="return confirm('确认修改该 Key 的权限档位？修改立即生效并记入审计日志。')">
                  <select name="permission_level" style="width:auto">
                    <option value="read_only" <%= k.permission_level === 'read_only' ? 'selected' : '' %>>只读</option>
                    <option value="read_write" <%= k.permission_level === 'read_write' ? 'selected' : '' %>>读+写</option>
                    <option value="full" <%= k.permission_level === 'full' ? 'selected' : '' %>>最大权限</option>
                  </select>
                  <button type="submit" class="btn btn-secondary btn-sm">修改</button>
                </form>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
            <td>
              <% if (!k.revoked_at) { %>
                <form method="POST" action="/platform-admin/api-keys/<%= k.id %>/revoke" onsubmit="return confirm('确认吊销该 Key？吊销后立即无法调用任何 API 端点，且不可恢复。')">
                  <button type="submit" class="btn btn-danger btn-sm">吊销</button>
                </form>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
          </tr>
        <% }) %>
      </table>
      <% if (keys.length === 0) { %><p class="muted">还没有生成任何 API Key</p><% } %>
    </div>
  </div>
</div>
</body>
</html>
