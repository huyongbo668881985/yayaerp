<%- include('partials/header') %>
<h1>调拨单 #<%= order.id %></h1>
<div class="card">
  <p><strong>日期：</strong><%= order.order_date %> &nbsp; <strong><%= order.from_name %></strong> → <strong><%= order.to_name %></strong></p>
  <p><strong>操作人：</strong><%= order.user_name %> &nbsp; <strong>备注：</strong><%= order.remarks || '-' %> &nbsp; <strong>内部备注：</strong><%= order.note || '-' %></p>
  <p>
    <strong>审核状态：</strong>
    <%
      const statusMap = {
        draft:     { text: '草稿',   bg: '#f3f4f6', fg: '#6b7280' },
        submitted: { text: '待审核', bg: '#fef3c7', fg: '#92400e' },
        approved:  { text: '已审核', bg: '#dbeafe', fg: '#1e40af' },
        rejected:  { text: '已拒绝', bg: '#fee2e2', fg: '#991b1b' }
      };
      const st = statusMap[order.status] || { text: order.status, bg: '#f3f4f6', fg: '#6b7280' };
    %>
    <span class="badge" style="background:<%= st.bg %>;color:<%= st.fg %>"><%= st.text %></span>
    <% if (order.status === 'draft' || order.status === 'submitted') { %>
      <span class="muted">（未审核，库存尚未变动）</span>
    <% } %>
  </p>
  <table>
    <tr><th>商品</th><th>数量</th></tr>
    <% items.forEach(function(it) { %>
      <tr>
        <td><%= it.product_name %></td>
        <td><%= it.quantity %> <%= it.unit_label %></td>
      </tr>
    <% }) %>
  </table>

  <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px">
    <% if (order.status === 'draft' && canManage) { %>
      <a class="btn" href="/transfers/<%= order.id %>/edit">编辑</a>
      <form action="/transfers/submit/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">提交审核</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && canManage) { %>
      <form action="/transfers/withdraw/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-secondary">撤回修改</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && currentUser.role === 'admin') { %>
      <form action="/transfers/approve/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">审核通过</button>
      </form>
      <form action="/transfers/reject/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-danger">审核拒绝</button>
      </form>
    <% } %>

    <% if ((order.status === 'approved' || order.status === 'rejected') && currentUser.role === 'admin') { %>
      <form action="/transfers/unapprove/<%= order.id %>" method="POST" onsubmit="return confirm('反审核会把该调拨单退回待审核状态<% if (order.status === 'approved') { %>，并把库存变动还原<% } %>，确认继续？')">
        <button type="submit" class="btn btn-secondary">反审核</button>
      </form>
    <% } %>

    <a class="btn btn-secondary" href="/transfers">返回列表</a>
  </div>
</div>
<%- include('partials/footer') %>
