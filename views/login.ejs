<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录 - 鸭鸭进销存</title>
  <link rel="stylesheet" href="/style.css">

  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2f6feb">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" sizes="192x192" href="/icons/icon-192.png">
  <link rel="icon" sizes="512x512" href="/icons/icon-512.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="鸭鸭进销存">
</head>
<body>
<div class="login-wrap">
  <div class="card login-card">
    <h1>📦 进销存系统</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <div class="form-row">
        <label>租户代码</label>
        <input type="text" name="tenant_code" value="<%= tenantCode || '' %>" required autofocus>
      </div>
      <div class="form-row">
        <label>用户名</label>
        <input type="text" name="username" required>
      </div>
      <div class="form-row">
        <label>密码</label>
        <input type="password" name="password" required>
      </div>
      <button class="btn" type="submit" style="width:100%">登录</button>
    </form>
  </div>
</div>
</body>
</html>
