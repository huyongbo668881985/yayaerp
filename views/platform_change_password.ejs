<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>平台管理 - 修改密码</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/csrf.js" defer></script>
</head>
<body>
<div class="topbar">
  <div class="brand">🛠 平台管理后台</div>
</div>
<div class="container">
  <h1>修改密码</h1>
  <div class="card" style="max-width:420px">
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <% if (success) { %><div class="success" style="color:#166534;background:#dcfce7;padding:8px 12px;border-radius:6px;margin-bottom:12px">密码修改成功</div><% } %>
    <% if (typeof forced !== 'undefined' && forced && !success) { %>
      <div class="error" style="color:#92400e;background:#fef3c7;padding:8px 12px;border-radius:6px;margin-bottom:12px">
        当前账号仍在使用初始密码，必须修改后才能进入后台其它页面。
      </div>
    <% } %>
    <form method="POST" action="/platform-admin/change-password">
      <div class="form-row">
        <label>原密码</label>
        <input type="password" name="old_password" required>
      </div>
      <div class="form-row">
        <label>新密码</label>
        <input type="password" name="new_password" minlength="6" required>
      </div>
      <button class="btn" type="submit" style="width:100%">保存</button>
    </form>
  </div>
  <% if (success) { %>
    <p style="margin-top:14px"><a href="/platform-admin">← 进入后台</a></p>
  <% } else if (typeof forced === 'undefined' || !forced) { %>
    <p style="margin-top:14px"><a href="/platform-admin">← 返回租户列表</a></p>
  <% } %>
</div>
</body>
</html>
