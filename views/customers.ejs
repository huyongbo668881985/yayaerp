<%- include('partials/header') %>
<div class="page-heading-actions"><h1>客户管理</h1><a class="btn customer-add-trigger" href="#customerNewPanel" onclick="document.getElementById('customerNewPanel').open=true">＋新增</a></div>
<div class="card customer-search-card">
  <form method="GET" action="/customers" class="customer-search-form">
    <div class="form-row">
      <label for="customerQuery">查询客户</label>
      <input id="customerQuery" type="search" name="q" value="<%= query %>" placeholder="名称、联系人、电话或地址">
    </div>
    <button type="submit" class="btn btn-secondary">查询</button>
    <% if (query) { %><a class="btn btn-secondary" href="/customers">清除</a><% } %>
  </form>
  <p class="muted customer-count"><%= query ? '查询结果 ' + displayedCustomerCount + ' 位' : '客户数量 ' + totalCustomerCount + ' 位' %><% if (query) { %>（共 <%= totalCustomerCount %> 位客户）<% } %></p>
</div>
<details class="card customer-new-panel" id="customerNewPanel" open>
  <summary>新增客户 <span>展开填写</span></summary>
  <div class="customer-new-content">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="/customers/new" class="grid-3">
    <div class="form-row"><label>名称 *</label><input type="text" name="name" required pattern="\S+" title="客户名称不能包含空格"></div>
    <div class="form-row"><label>联系人</label><input type="text" name="contact"></div>
    <div class="form-row"><label>电话</label><input type="text" name="phone"></div>
    <div class="form-row" style="grid-column: 1 / -1"><label>地址</label><input type="text" name="address" placeholder="送货地址"></div>
    <% if (isAdmin) { %>
      <div class="form-row">
        <label>归属业务员</label>
        <select name="operator_id">
          <option value="">-- 不指定 --</option>
          <% users.forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %>（<%= u.role === 'admin' ? '管理员' : '操作员' %>）</option><% }) %>
        </select>
      </div>
    <% } else { %>
      <p class="muted" style="grid-column: 1 / -1">新增的客户会自动归到你名下</p>
    <% } %>
    <div><button class="btn" type="submit">新增</button></div>
  </form>
  </div>
</details>
<script>
  (function() {
    const panel = document.getElementById('customerNewPanel');
    const hasError = <%= error ? 'true' : 'false' %>;
    function sync() { if (window.matchMedia('(min-width: 769px)').matches || hasError) panel.open = true; }
    if (window.matchMedia('(max-width: 768px)').matches && !hasError) panel.open = false;
    window.addEventListener('resize', sync);
  })();
</script>

<% if (isAdmin) { %>
<details class="card customer-reassign">
  <summary>
    <span>更多管理 · 批量转移客户归属</span>
    <span class="customer-reassign-hint">按需展开</span>
  </summary>
  <div class="customer-reassign-content">
    <p class="muted">业务员离职或换岗时，一次性把他名下所有客户转给接手的人，不用一个个改。</p>
    <form method="POST" action="/customers/reassign" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap" onsubmit="return confirm('确认要把这些客户全部转移吗？')">
      <div class="form-row" style="margin-bottom:0">
        <label>原业务员</label>
        <select name="from_user_id" required>
          <option value="">-- 请选择 --</option>
          <% users.forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
        </select>
      </div>
      <div class="form-row" style="margin-bottom:0">
        <label>转给</label>
        <select name="to_user_id" required>
          <option value="">-- 请选择 --</option>
          <% users.forEach(function(u) { %><option value="<%= u.id %>"><%= u.name %></option><% }) %>
        </select>
      </div>
      <button type="submit" class="btn">批量转移</button>
    </form>
  </div>
</details>
<% } %>

<div class="card desktop-table-wrap">
  <table>
    <tr><th>名称</th><th>联系人</th><th>电话</th><th>地址</th><th>归属业务员</th><th>操作</th></tr>
    <% customers.forEach(function(c) { %>
      <tr>
        <td><%= c.name %></td>
        <td><%= c.contact || '-' %></td>
        <td><%= c.phone || '-' %></td>
        <td><%= c.address || '-' %></td>
        <td><%= c.operator_name || '-' %></td>
        <td class="customer-table-actions">
          <div class="customer-primary-actions">
            <a href="/sales?customer_id=<%= c.id %>" class="btn btn-sm btn-secondary">查订单</a>
            <a href="/sales/new?customer_id=<%= c.id %>" class="btn btn-sm">新开单</a>
          </div>
          <div class="customer-secondary-actions">
            <% if (isAdmin || c.operator_id === currentUser.id) { %>
              <a href="/customers/<%= c.id %>/edit">编辑资料</a>
            <% } %>
            <% if (isAdmin) { %>
              <form method="POST" action="/customers/<%= c.id %>/delete" onsubmit="return confirm('确认删除？如果该客户有历史订单会删除失败。')">
                <button type="submit" class="customer-delete-link">删除</button>
              </form>
            <% } %>
          </div>
        </td>
      </tr>
    <% }) %>
  </table>
</div>

<div class="mobile-order-cards">
  <% customers.forEach(function(c) { %>
    <div class="order-card customer-card">
      <div class="order-card-top">
        <span class="order-card-id"><%= c.name %></span>
      </div>
      <div class="order-card-mid">
        <span><%= c.contact || '-' %><% if (c.phone) { %> · <a href="tel:<%= c.phone.replace(/[^+\d]/g, '') %>" class="customer-contact-link"><%= c.phone %></a><% } %></span>
        <span><%= c.operator_name || '未指定业务员' %></span>
      </div>
      <% if (c.address) { %><div class="customer-address"><span><%= c.address %></span><button type="button" class="customer-copy-address" data-address="<%= c.address %>" onclick="copyCustomerAddress(this)">复制地址</button></div><% } %>
      <div class="customer-primary-actions">
        <a href="/sales?customer_id=<%= c.id %>" class="btn btn-secondary">查订单</a>
        <a href="/sales/new?customer_id=<%= c.id %>" class="btn">新开单</a>
      </div>
      <details class="customer-more-actions"><summary>更多操作</summary><div class="customer-secondary-actions">
        <% if (isAdmin || c.operator_id === currentUser.id) { %>
          <a href="/customers/<%= c.id %>/edit">编辑资料</a>
        <% } %>
        <% if (isAdmin) { %>
          <form method="POST" action="/customers/<%= c.id %>/delete" onsubmit="return confirm('确认删除？如果该客户有历史订单会删除失败。')">
            <button type="submit" class="customer-delete-link">删除</button>
          </form>
        <% } %>
      </div></details>
    </div>
  <% }) %>
  <% if (customers.length === 0) { %><p class="muted">暂无客户</p><% } %>
</div>
<script>
  async function copyCustomerAddress(button) {
    try {
      await navigator.clipboard.writeText(button.dataset.address);
      button.textContent = '已复制';
      setTimeout(function() { button.textContent = '复制地址'; }, 2000);
    } catch (error) { button.textContent = '复制失败'; }
  }
</script>
<%- include('partials/footer') %>
