<% const query=new URLSearchParams({start,end}).toString(); %>
<% if(!print){ %><%- include('partials/header') %><div class="page-heading-actions"><h1><%= supplier.name %> · 采购对账</h1><div class="action-row"><a class="btn btn-secondary" href="/reconciliation">返回对账</a><a class="btn btn-secondary" href="?format=csv&<%= query %>">导出 CSV</a><a class="btn" href="?print=1&<%= query %>">打印 / PDF</a></div></div><% } else { %><%- include('partials/print_head',{title:supplier.name+' · 采购对账单',back:'?'+query,receipt:false}) %><% } %>
<p><%= start %> 至 <%= end %> · 供应商：<%= supplier.name %> · 电话：<%= supplier.phone||'—' %></p><p class="muted">本表核对采购入库金额。供应商付款尚未记录，采购金额不代表未付账款。</p><p class="print-total">共 <%= orders.length %> 张采购单，合计 ¥<%= total.toFixed(2) %></p>
<div class="<%= print?'':'card statement-table-wrap' %>"><table><thead><tr><th>采购单号</th><th>日期</th><th>仓库</th><th>金额</th><th>备注</th></tr></thead><tbody><% orders.forEach(function(order){ %><tr><td>#<%= order.id %></td><td><%= order.order_date %></td><td><%= order.warehouse_name %></td><td><%= order.total_amount.toFixed(2) %></td><td><%= order.note||'—' %></td></tr><% }); %></tbody></table></div>
<% if(!print){ %><div class="mobile-order-cards"><% orders.forEach(function(order){ %><div class="order-card"><div class="order-card-top"><a href="/purchases/<%= order.id %>">采购单 #<%= order.id %></a><strong>¥<%= order.total_amount.toFixed(2) %></strong></div><p><%= order.order_date %> · <%= order.warehouse_name %></p><p><%= order.note||'无备注' %></p></div><% }); %></div><% } %>
<% if(!orders.length){ %><p class="muted">所选日期没有采购单。</p><% } %>
<% if(print){ %><div class="print-signatures"><span>经办人：________</span><span>供应商确认：________</span></div><%- include('partials/print_foot') %><% } else { %><%- include('partials/footer') %><% } %>
