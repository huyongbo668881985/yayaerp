<%- include('partials/header') %>
<div class="tabbar">
  <a href="/products" class="active">商品</a>
  <a href="/warehouses">仓库</a>
</div>
<h1>商品档案</h1>
<p class="muted">箱价为整箱下单时使用的精确单价；瓶价仅为拆零参考价，可能有小数误差。库存预警阈值以基本单位计数。</p>
<% if (isAdmin) { %>
  <div style="margin-bottom:12px"><a class="btn" href="/products/new">+ 新增商品</a></div>
<% } %>
<div class="card desktop-table-wrap">
  <table>
    <tr>
      <th>SKU</th><th>名称</th><th>规格</th><th>单位换算</th>
      <% if (isAdmin) { %><th>箱成本价</th><% } %>
      <th>箱售价</th>
      <% if (isAdmin) { %><th>瓶成本价</th><% } %>
      <th>瓶售价</th><th>预警阈值</th>
      <% if (isAdmin) { %><th>操作</th><% } %>
    </tr>
    <% products.forEach(function(p) { %>
      <tr>
        <td><%= p.sku || '-' %></td>
        <td><%= p.name %></td>
        <td><%= p.spec || '-' %></td>
        <td>
          <% if (p.pack_unit) { %>
            1<%= p.pack_unit %> = <%= p.pack_size %><%= p.unit %>
          <% } else { %>
            <%= p.unit %>
          <% } %>
        </td>
        <% if (isAdmin) { %>
          <td><% if (p.cost_price_pack != null) { %>¥<%= p.cost_price_pack.toFixed(2) %><% } else if (p.pack_unit) { %>约¥<%= (p.cost_price * p.pack_size).toFixed(2) %><% } else { %>-<% } %></td>
        <% } %>
        <td><% if (p.sale_price_pack != null) { %>¥<%= p.sale_price_pack.toFixed(2) %><% } else if (p.pack_unit) { %>约¥<%= (p.sale_price * p.pack_size).toFixed(2) %><% } else { %>-<% } %></td>
        <% if (isAdmin) { %><td>¥<%= p.cost_price.toFixed(2) %></td><% } %>
        <td>¥<%= p.sale_price.toFixed(2) %></td>
        <td><%= p.low_stock_threshold %></td>
        <% if (isAdmin) { %>
          <td>
            <a href="/products/<%= p.id %>/edit">编辑</a>
            &nbsp;
            <form method="POST" action="/products/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('确认删除该商品？')">
              <button type="submit" style="background:none;border:none;color:#e5484d;cursor:pointer;padding:0">删除</button>
            </form>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </table>
</div>

<div class="mobile-order-cards">
  <% products.forEach(function(p) { %>
    <div class="order-card">
      <div class="order-card-top">
        <span class="order-card-id"><%= p.name %></span>
        <span class="order-card-amount">¥<%= p.sale_price.toFixed(2) %></span>
      </div>
      <div class="order-card-mid">
        <span><%= p.sku || '无SKU' %></span>
        <span><%= p.spec || '-' %></span>
      </div>
      <div class="order-card-bottom">
        <span class="muted">
          <% if (p.pack_unit) { %>1<%= p.pack_unit %> = <%= p.pack_size %><%= p.unit %><% } else { %><%= p.unit %><% } %>
          &nbsp;·&nbsp;预警 <%= p.low_stock_threshold %>
          <% if (isAdmin) { %>&nbsp;·&nbsp;成本 ¥<%= p.cost_price.toFixed(2) %><% } %>
        </span>
      </div>
      <% if (isAdmin) { %>
        <div style="display:flex; gap:8px; margin-top:10px">
          <a href="/products/<%= p.id %>/edit" class="btn btn-sm btn-secondary" style="flex:1; text-align:center">编辑</a>
          <form method="POST" action="/products/<%= p.id %>/delete" style="flex:1" onsubmit="return confirm('确认删除该商品？')">
            <button type="submit" class="btn btn-sm btn-danger" style="width:100%">删除</button>
          </form>
        </div>
      <% } %>
    </div>
  <% }) %>
  <% if (products.length === 0) { %><p class="muted">暂无商品</p><% } %>
</div>
<%- include('partials/footer') %>
