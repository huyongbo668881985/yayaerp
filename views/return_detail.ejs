<%- include('partials/header') %>
<h1>退货单 #<%= order.id %></h1>
<div class="card">
  <p>
    <strong>日期：</strong><%= order.order_date %> &nbsp;
    <strong>客户：</strong><%= order.customer_name || '散客' %> &nbsp;
    <strong>退回仓库：</strong><%= order.warehouse_name %>
  </p>
  <p>
    <strong>录入人：</strong><%= order.user_name %> &nbsp;
    <strong>备注：</strong><%= order.note || '-' %>
  </p>
  <% if (order.related_sales_order_id) { %>
    <p><strong>关联销售单：</strong><a href="/sales/<%= order.related_sales_order_id %>">#<%= order.related_sales_order_id %></a>（该单的应收金额已自动扣掉这次退货）</p>
  <% } %>
  <p>
    <strong>退款状态：</strong>
    <% if (order.refund_status === 'refunded') { %>
      <span class="badge" style="background:#dcfce7;color:#166534">已退款</span>
    <% } else if (order.refund_status === 'partial') { %>
      <span class="badge" style="background:#fef3c7;color:#92400e">部分退款</span>
    <% } else { %>
      <span class="badge" style="background:#fee2e2;color:#991b1b">未退款</span>
    <% } %>
    &nbsp;
    <strong>审核状态：</strong>
    <%
      const statusMap = {
        draft:     { text: '草稿',   bg: '#f3f4f6', fg: '#6b7280' },
        submitted: { text: '待审核', bg: '#fef3c7', fg: '#92400e' },
        approved:  { text: '已审核', bg: '#dbeafe', fg: '#1e40af' },
        rejected:  { text: '已拒绝', bg: '#fee2e2', fg: '#991b1b' }
      };
      const st = statusMap[order.status] || { text: order.status, bg: '#f3f4f6', fg: '#6b7280' };
    %>
    <span class="badge" style="background:<%= st.bg %>;color:<%= st.fg %>"><%= st.text %></span>
    <% if (order.status === 'draft' || order.status === 'submitted') { %>
      <span class="muted">（未审核，库存尚未变动）</span>
    <% } %>
  </p>
  <p>
    <strong>退货总金额：</strong>¥<%= order.total_amount.toFixed(2) %> &nbsp;
    <strong>已退现金：</strong>¥<%= (order.refunded_amount || 0).toFixed(2) %> &nbsp;
    <strong>还差：</strong>¥<%= (order.total_amount - (order.refunded_amount || 0)).toFixed(2) %>
  </p>
  <table>
    <tr><th>商品</th><th>数量</th><th>单价</th><th>小计</th></tr>
    <% items.forEach(function(it) { %>
      <tr>
        <td><%= it.product_name %></td>
        <td><%= it.quantity %> <%= it.unit_label %></td>
        <td>¥<%= it.unit_price.toFixed(2) %></td>
        <td>¥<%= (it.quantity * it.unit_price).toFixed(2) %></td>
      </tr>
    <% }) %>
  </table>
  <p class="right"><strong>总计：¥<%= order.total_amount.toFixed(2) %></strong></p>

  <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px">
    <% if (order.status === 'draft' && canManage) { %>
      <a class="btn" href="/returns/<%= order.id %>/edit">编辑</a>
      <form action="/returns/submit/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">提交审核</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && canManage) { %>
      <form action="/returns/withdraw/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-secondary">撤回修改</button>
      </form>
    <% } %>

    <% if (order.status === 'submitted' && currentUser.role === 'admin') { %>
      <form action="/returns/approve/<%= order.id %>" method="POST">
        <button type="submit" class="btn" style="background:#16a34a">审核通过（入库）</button>
      </form>
      <form action="/returns/reject/<%= order.id %>" method="POST">
        <button type="submit" class="btn btn-danger">审核拒绝</button>
      </form>
    <% } %>

    <% if ((order.status === 'approved' || order.status === 'rejected') && currentUser.role === 'admin') { %>
      <form action="/returns/unapprove/<%= order.id %>" method="POST" onsubmit="return confirm('反审核会把该退货单退回待审核状态<% if (order.status === 'approved') { %>，并把加回去的库存再扣回来<% } %>，确认继续？')">
        <button type="submit" class="btn btn-secondary">反审核</button>
      </form>
    <% } %>

    <% const refundRemaining = order.total_amount - (order.refunded_amount || 0); %>
    <% if (order.status === 'approved' && currentUser.role === 'admin' && refundRemaining > 0.001) { %>
      <form action="/returns/<%= order.id %>/record-refund" method="POST" style="display:flex; gap:6px; align-items:center">
        <input type="number" name="amount" placeholder="本次退款金额" step="0.01" min="0.01" max="<%= refundRemaining.toFixed(2) %>" required style="width:140px">
        <button type="submit" class="btn btn-danger">记录退款</button>
      </form>
    <% } %>

    <a class="btn btn-secondary" href="/returns">返回列表</a>
  </div>
</div>
<%- include('partials/footer') %>
