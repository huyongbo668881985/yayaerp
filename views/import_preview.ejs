<%- include('partials/header') %>
<div class="page-heading-actions"><h1><%= definition.name %>导入预览</h1><a href="/imports" class="btn btn-secondary">返回导入</a></div>
<p class="muted"><%= batch.filename %> · <%= preview.length %> 条 · <%= definition.help %></p>
<% if(error) { %><div class="error" role="alert"><%= error %></div><% } %>
<% const invalid=preview.filter(row=>row.errors.length).length;const writes=preview.filter(row=>!row.errors.length && ['新增','调整'].includes(row.action)).length; %>
<% if(result) { %><div class="flow-notice" role="status"><strong>导入完成</strong><span>写入 <%= result.written %> 条，跳过 <%= result.skipped %> 条。重复确认不会再次写入。</span></div><div class="action-row"><a class="btn" href="/<%= batch.kind %>">查看<%= definition.name %></a><% if(batch.kind==='inventory'){ %><form method="POST" action="/imports/batches/<%= batch.id %>/restart"><button class="btn btn-secondary" type="submit">用此文件重新发起盘点</button></form><% } %></div><% if(batch.kind==='inventory'){ %><p class="muted">重新发起将创建新预览，按当前库存重新计算差额；仍需核对并确认。</p><% } %>
<% } else { %>
<section class="card"><p>计划写入 <strong><%= writes %></strong> 条；跳过或无变化 <%= preview.length-writes-invalid %> 条；错误 <strong><%= invalid %></strong> 条。</p>
<% if(invalid) { %><p class="error" role="alert">存在错误行，整批不会写入。请修正后重新上传。</p><% } %>
<div class="action-row"><form method="POST" action="/imports/batches/<%= batch.id %>/recheck"><button type="submit" class="btn btn-secondary">重新校验</button></form><form method="POST" action="/imports/batches/<%= batch.id %>/confirm"><button type="submit" class="btn" <%= invalid?'disabled':'' %>>确认导入 <%= writes %> 条</button></form></div></section>
<% } %>
<div class="card import-preview-wrap"><table><thead><tr><th>文件行</th><th>处理</th><% definition.headers.forEach(function(h){ %><th><%= h %></th><% }) %><% if(batch.kind==='inventory'){ %><th>当前库存 → 实盘</th><% } %><th>校验</th></tr></thead><tbody><% preview.forEach(function(row){ %><tr><td><%= row.line %></td><td><%= row.action %></td><% definition.keys.forEach(function(k){ %><td><%= row.values[k]||'—' %></td><% }) %><% if(batch.kind==='inventory'){ %><td><%= row.stock??'—' %> → <%= row.normalized.quantity %> <%= row.normalized.unit||'' %><br>差额 <%= row.normalized.change??'—' %></td><% } %><td><%= row.errors.join('；')||'通过' %></td></tr><% }) %></tbody></table></div>
<div class="mobile-order-cards"><% preview.forEach(function(row){ %><section class="order-card"><div class="order-card-top"><strong>第 <%= row.line %> 行 · <%= row.values.name||row.normalized.product_name||row.values.sku %></strong><span><%= row.action %></span></div><% definition.keys.forEach(function(k,i){if(row.values[k]){ %><p><span class="muted"><%= definition.headers[i] %>：</span><%= row.values[k] %></p><% }}); %><% if(batch.kind==='inventory'){ %><p>当前 <%= row.stock??'—' %> → 实盘 <%= row.normalized.quantity %> <%= row.normalized.unit||'' %>（差额 <%= row.normalized.change??'—' %>）</p><% } %><p class="<%= row.errors.length?'error':'muted' %>"><%= row.errors.join('；')||'校验通过' %></p></section><% }) %></div>
<%- include('partials/footer') %>
