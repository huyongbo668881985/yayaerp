<%- include('partials/header') %>
<div class="page-heading-actions"><h1>库存查询</h1><% if (isAdmin) { %><a class="inventory-adjust-link" href="/inventory/adjust">库存调整</a><% } %></div>
<div class="card inventory-filter-card">
  <form method="GET" action="/inventory" class="inventory-filter-form">
    <div class="form-row inventory-search-row">
      <label for="inventorySearch">商品名称或 SKU</label>
      <input id="inventorySearch" type="search" name="q" value="<%= search %>" placeholder="搜索商品">
    </div>
    <div class="form-row inventory-warehouse-row">
      <label for="inventoryWarehouse">仓库</label>
      <select id="inventoryWarehouse" name="warehouse_id">
        <option value="">-- <%= isAdmin ? '全部仓库' : '我的车辆仓库' %> --</option>
        <% warehouses.forEach(function(w) { %>
          <option value="<%= w.id %>" <%= String(warehouseId) === String(w.id) ? 'selected' : '' %>><%= w.name %></option>
        <% }) %>
      </select>
    </div>
    <label class="inventory-low-toggle"><input type="checkbox" name="low" value="1" <%= lowOnly ? 'checked' : '' %>> 只看低库存</label>
    <button class="btn" type="submit">查询</button>
    <% if (search || warehouseId || lowOnly) { %><a class="btn btn-secondary" href="/inventory">清除</a><% } %>
  </form>
  <p class="muted inventory-count">找到 <%= rows.length %> 条库存记录</p>
</div>
<div class="card desktop-table-wrap">
  <table>
    <tr><th>商品</th><th>规格</th><th>仓库</th><th>库存数量</th></tr>
    <% rows.forEach(function(r) { %>
      <tr>
        <td><%= r.name %></td>
        <td><%= r.spec || '-' %></td>
        <td><%= r.warehouse_name %></td>
        <td>
          <% const qtyText = r.quantity + ' ' + r.unit + (r.pack_unit ? ' (' + Math.floor(r.quantity / r.pack_size) + r.pack_unit + (r.quantity % r.pack_size ? '余' + (r.quantity % r.pack_size) + r.unit : '') + ')' : ''); %>
          <% if (r.low_stock_threshold > 0 && r.quantity <= r.low_stock_threshold) { %>
            <span class="badge badge-low"><%= qtyText %></span>
          <% } else { %>
            <%= qtyText %>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table>
</div>

<div class="mobile-order-cards">
  <% rows.forEach(function(r) { %>
    <% const qtyText = r.quantity + ' ' + r.unit + (r.pack_unit ? ' (' + Math.floor(r.quantity / r.pack_size) + r.pack_unit + (r.quantity % r.pack_size ? '余' + (r.quantity % r.pack_size) + r.unit : '') + ')' : ''); %>
    <% const isLow = r.low_stock_threshold > 0 && r.quantity <= r.low_stock_threshold; %>
    <div class="order-card">
      <div class="order-card-top">
        <span class="order-card-id"><%= r.name %></span>
        <% if (isLow) { %><span class="badge badge-low">库存偏低</span><% } %>
      </div>
      <div class="order-card-mid">
        <span><%= r.spec || '常规规格' %><% if (r.sku) { %> · <%= r.sku %><% } %></span>
        <span><%= r.warehouse_name %></span>
      </div>
      <div class="order-card-bottom">
        <span class="order-card-amount <%= isLow ? 'is-low' : '' %>"><small>可用库存</small><%= qtyText %></span>
      </div>
    </div>
  <% }) %>
  <% if (rows.length === 0) { %><p class="muted">暂无库存数据</p><% } %>
</div>
<%- include('partials/footer') %>
