<%- include('partials/header') %>
<h1>出入库流水<% if (!start && !end) { %>（最近200条）<% } %></h1>

<div class="card">
  <form method="GET" action="/stock-log" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
    <div class="form-row" style="margin-bottom:0">
      <label>开始日期</label>
      <input type="date" name="start" value="<%= start %>">
    </div>
    <div class="form-row" style="margin-bottom:0">
      <label>结束日期</label>
      <input type="date" name="end" value="<%= end %>">
    </div>
    <button type="submit" class="btn btn-secondary">筛选</button>
    <a class="btn btn-secondary" href="/stock-log">清除</a>
    <a class="btn" href="/stock-log/export?start=<%= start %>&end=<%= end %>">导出CSV</a>
  </form>
</div>
<div class="card desktop-table-wrap">
  <table>
    <tr><th>时间</th><th>商品</th><th>仓库</th><th>类型</th><th>数量变化</th><th>操作人</th></tr>
    <% logs.forEach(function(l) { %>
      <tr>
        <td><%= l.created_at %></td>
        <td><%= l.product_name %></td>
        <td><%= l.warehouse_name %></td>
        <td>
          <%
            const typeLabels = { purchase_in: '采购入库', sale_out: '销售出库', transfer_out: '调拨调出', transfer_in: '调拨调入', adjust: '库存调整', sale_return: '销售退货入库' };
          %>
          <%= typeLabels[l.type] || l.type %>
        </td>
        <td style="color: <%= l.change_qty > 0 ? '#16a34a' : '#e5484d' %>">
          <%= l.change_qty > 0 ? '+' : '' %><%= l.change_qty %> <%= l.unit %>
        </td>
        <td><%= l.user_name || '-' %></td>
      </tr>
    <% }) %>
  </table>
</div>

<div class="mobile-order-cards">
  <% const logTypeLabels = { purchase_in: '采购入库', sale_out: '销售出库', transfer_out: '调拨调出', transfer_in: '调拨调入', adjust: '库存调整', sale_return: '销售退货入库' }; %>
  <% logs.forEach(function(l) { %>
    <div class="order-card">
      <div class="order-card-top">
        <span class="order-card-id"><%= l.product_name %></span>
        <span style="color: <%= l.change_qty > 0 ? '#16a34a' : '#e5484d' %>; font-weight:700">
          <%= l.change_qty > 0 ? '+' : '' %><%= l.change_qty %> <%= l.unit %>
        </span>
      </div>
      <div class="order-card-mid">
        <span><%= l.warehouse_name %></span>
        <span><%= logTypeLabels[l.type] || l.type %></span>
      </div>
      <div class="order-card-bottom">
        <span class="muted"><%= l.created_at %></span>
        <span class="muted"><%= l.user_name || '-' %></span>
      </div>
    </div>
  <% }) %>
  <% if (logs.length === 0) { %><p class="muted">暂无流水记录</p><% } %>
</div>
<%- include('partials/footer') %>
