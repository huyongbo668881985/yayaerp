<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>出错了</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="login-wrap">
  <div class="card login-card">
    <h1>⚠️ 操作未能完成</h1>
    <p role="alert"><%= message %></p>
    <% if (typeof requestId !== 'undefined') { %><p class="muted">问题编号：<%= requestId %></p><% } %>
    <a href="<%= typeof returnTo !== 'undefined' ? returnTo : '/' %>" class="btn" style="display:inline-block;margin-top:10px"><%= typeof returnLabel !== 'undefined' ? returnLabel : '返回继续操作' %></a>
  </div>
</div>
</body>
</html>
