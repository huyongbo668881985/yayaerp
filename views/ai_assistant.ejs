<%- include('partials/header') %>

<style>
  .ai-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
  }
  .ai-page-header h1 {
    margin: 0;
  }
  .ai-status-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .ai-toolbar-card {
    padding: 14px 16px;
    margin-bottom: 14px;
  }
  .ai-toolbar-grid {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    flex-wrap: wrap;
  }
  .ai-toolbar-grid .form-row {
    margin-bottom: 0;
    flex: 1;
    min-width: 200px;
  }
  /* 可搜索门店选择器 */
  .ai-store-picker {
    position: relative;
  }
  .ai-store-input-wrap {
    display: flex;
    gap: 6px;
    align-items: center;
    position: relative;
  }
  .ai-store-input-wrap input[type="search"] {
    width: 100%;
    padding-right: 12px;
  }
  .ai-store-reset-btn {
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ai-store-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 280px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(31, 35, 40, 0.14);
    z-index: 1200;
    padding: 6px;
    margin: 0;
    list-style: none;
  }
  .ai-store-dropdown[hidden] {
    display: none !important;
  }
  .ai-store-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 13px;
    color: #1f2328;
    cursor: pointer;
  }
  .ai-store-option:hover,
  .ai-store-option.active {
    background: #eef4ff;
    color: #0969da;
  }
  .ai-store-option.selected {
    font-weight: 600;
    background: #ddf4ff;
    color: #0969da;
  }
  .ai-store-option-op {
    font-size: 12px;
    color: #57606a;
    flex-shrink: 0;
  }
  .ai-store-empty {
    padding: 12px 10px;
    font-size: 12px;
    color: #57606a;
    text-align: center;
  }
  /* 历史对话面板 */
  .ai-history-panel {
    margin-bottom: 14px;
    padding: 14px 16px;
    border: 1px solid #d0d7de;
    background: #fff;
  }
  .ai-history-panel[hidden] {
    display: none !important;
  }
  .ai-history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid #eaeef2;
  }
  .ai-history-title {
    font-size: 14px;
    font-weight: 600;
    color: #1f2328;
    margin: 0;
  }
  .ai-history-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 260px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ai-history-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid #eaeef2;
    border-radius: 8px;
    background: #fafbfc;
    transition: all 0.15s ease;
  }
  .ai-history-item:hover {
    border-color: #2f6feb;
    background: #f0f6ff;
  }
  .ai-history-item.active {
    border-color: #2f6feb;
    background: #eef4ff;
  }
  .ai-history-select-btn {
    flex: 1;
    min-width: 0;
    text-align: left;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  .ai-history-item-title {
    font-size: 13px;
    font-weight: 600;
    color: #1f2328;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
  }
  .ai-history-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
    color: #57606a;
  }
  .ai-history-empty {
    padding: 20px 12px;
    text-align: center;
    color: #57606a;
    font-size: 13px;
  }
  .ai-history-footer {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed #eaeef2;
    font-size: 12px;
    color: #57606a;
  }
  .ai-chips-section {
    margin-bottom: 14px;
  }
  .ai-chips-label {
    font-size: 12px;
    color: #57606a;
    margin-bottom: 6px;
    display: block;
  }
  .ai-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ai-chip-btn {
    background: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 13px;
    color: #1f2328;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: left;
    line-height: 1.35;
  }
  .ai-chip-btn:hover:not(:disabled) {
    background: #eef4ff;
    border-color: #2f6feb;
    color: #0969da;
  }
  .ai-chip-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .ai-chat-card {
    display: flex;
    flex-direction: column;
    min-height: 460px;
    padding: 0;
    overflow: hidden;
  }
  .ai-messages {
    flex: 1;
    padding: 18px;
    overflow-y: auto;
    max-height: 68vh;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #fafbfc;
  }
  .ai-empty-state {
    text-align: center;
    padding: 42px 20px;
    color: #57606a;
  }
  .ai-empty-state h2 {
    font-size: 17px;
    color: #1f2328;
    margin: 0 0 8px;
  }
  .ai-empty-state p {
    font-size: 13px;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .ai-msg {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 92%;
  }
  .ai-msg-user {
    align-self: flex-end;
    align-items: flex-end;
  }
  .ai-msg-assistant {
    align-self: flex-start;
    align-items: flex-start;
    width: 100%;
    max-width: 100%;
  }
  .ai-bubble-user {
    background: #2f6feb;
    color: #fff;
    padding: 10px 15px;
    border-radius: 14px 14px 2px 14px;
    font-size: 14px;
    line-height: 1.5;
    word-break: break-word;
  }
  .ai-bubble-assistant {
    background: #fff;
    border: 1px solid #d8dee4;
    border-radius: 12px;
    padding: 16px;
    width: 100%;
    box-sizing: border-box;
    box-shadow: 0 1px 2px rgba(31, 35, 40, 0.04);
  }
  .ai-status-step {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #0969da;
    background: #ddf4ff;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .ai-evidence-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }
  .ai-evidence-card {
    background: #f6f8fa;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .ai-evidence-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
    font-weight: 600;
    font-size: 13px;
    color: #1f2328;
  }
  .ai-evidence-links {
    display: flex;
    gap: 10px;
    font-size: 12px;
    font-weight: normal;
  }
  .ai-metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }
  .ai-metric-box {
    background: #fff;
    border: 1px solid #eaeef2;
    border-radius: 8px;
    padding: 8px 10px;
  }
  .ai-metric-label {
    font-size: 12px;
    color: #57606a;
  }
  .ai-metric-value {
    font-size: 16px;
    font-weight: 700;
    color: #1f2328;
    margin: 2px 0;
  }
  .ai-metric-sub {
    font-size: 11px;
    color: #656d76;
  }
  .ai-stopped-alert {
    margin-top: 8px;
    font-size: 12px;
    color: #9a6700;
    background: #fff8c5;
    border: 1px solid #d4a72c;
    border-radius: 6px;
    padding: 6px 10px;
  }
  .ai-photo-strip {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    margin-top: 10px;
    padding-bottom: 4px;
  }
  .ai-photo-item {
    flex: 0 0 120px;
    background: #fff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    overflow: hidden;
    font-size: 11px;
  }
  .ai-photo-item img {
    width: 120px;
    height: 90px;
    object-fit: cover;
    display: block;
    cursor: zoom-in;
  }
  .ai-photo-caption {
    padding: 4px 6px;
    color: #57606a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ai-markdown-body {
    font-size: 14px;
    line-height: 1.65;
    color: #1f2328;
  }
  .ai-markdown-body h3, .ai-markdown-body h4 {
    margin: 12px 0 6px;
    font-size: 15px;
  }
  .ai-markdown-body ul, .ai-markdown-body ol {
    margin: 6px 0;
    padding-left: 20px;
  }
  .ai-markdown-body li {
    margin-bottom: 4px;
  }
  .ai-markdown-body p {
    margin: 6px 0;
  }
  .ai-markdown-body blockquote {
    margin: 8px 0;
    padding: 8px 12px;
    background: #f6f8fa;
    border-left: 3px solid #2f6feb;
    color: #57606a;
    font-size: 13px;
  }
  .ai-msg-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed #eaeef2;
  }
  .ai-input-bar {
    display: flex;
    gap: 10px;
    padding: 12px 16px;
    background: #fff;
    border-top: 1px solid #d8dee4;
    align-items: flex-end;
  }
  .ai-input-bar textarea {
    flex: 1;
    resize: none;
    min-height: 42px;
    max-height: 120px;
    padding: 9px 12px;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.4;
    font-family: inherit;
  }
  .ai-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 20px;
  }
  .ai-lightbox.open {
    display: flex;
  }
  .ai-lightbox img {
    max-width: 94vw;
    max-height: 88vh;
    border-radius: 8px;
    background: #fff;
  }
  @media (max-width: 768px) {
    .ai-messages {
      padding: 12px;
      max-height: 62vh;
    }
    .ai-toolbar-grid .form-row {
      min-width: 100%;
    }
    .ai-metrics-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<div class="ai-page-header">
  <h1>✨ 经营诊断助手</h1>
  <div class="ai-status-badges">
    <span class="badge badge-operator">📊 进销存账务已就绪</span>
    <% if (aiStatus.shelfguardEnabled) { %>
      <span class="badge <%= aiStatus.shelfguardConfigured ? 'badge-operator' : 'badge-low' %>">
        📸 ShelfGuard 巡检<%= aiStatus.shelfguardConfigured ? '已联动' : '待配密钥' %>
      </span>
    <% } else { %>
      <span class="badge" style="background:#eaeef2;color:#57606a">仅进销存模式</span>
    <% } %>
  </div>
</div>

<div class="card ai-toolbar-card">
  <div class="ai-toolbar-grid">
    <div class="form-row ai-store-picker" id="aiStorePicker">
      <label for="aiCustomerSearchInput">诊断对象（支持输入店名或业务员搜索）</label>
      <div class="ai-store-input-wrap">
        <input
          type="search"
          id="aiCustomerSearchInput"
          placeholder="🔍 输入门店名称或业务员搜索（留空为全局视角）…"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="aiCustomerDropdown"
        >
        <button type="button" class="btn btn-secondary btn-sm ai-store-reset-btn" id="aiCustomerResetGlobalBtn" hidden>切回全局</button>
      </div>
      <ul class="ai-store-dropdown" id="aiCustomerDropdown" role="listbox" hidden></ul>
      <select id="aiCustomerSelect" hidden aria-hidden="true" tabindex="-1">
        <option value="">🏢 全局视角（全部门店排行与对比）</option>
        <% customers.forEach(function(c) { %>
          <option value="<%= c.id %>" data-name="<%= c.name %>" data-operator="<%= c.operator_name || '' %>" <%= initialCustomerId === c.id ? 'selected' : '' %>>
            <%= c.name %><%= c.operator_name ? '（' + c.operator_name + '）' : '' %>
          </option>
        <% }) %>
      </select>
    </div>
    <div class="form-row" style="max-width: 220px;">
      <label for="aiDaysSelect">时间范围</label>
      <select id="aiDaysSelect">
        <option value="30">近 30 天（环比上个30天）</option>
        <option value="90" selected>近 90 天（环比上个90天）</option>
        <option value="180">近 180 天（半年趋势）</option>
      </select>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      <button type="button" class="btn btn-secondary" id="aiNewChatBtn">＋ 新建对话</button>
      <button type="button" class="btn btn-secondary" id="aiHistoryToggleBtn" aria-expanded="false" aria-controls="aiHistoryPanel">
        🕘 历史对话 (<span id="aiHistoryCount"><%= Array.isArray(sessions) ? sessions.length : 0 %></span>)
      </button>
    </div>
  </div>
</div>

<section class="card ai-history-panel" id="aiHistoryPanel" aria-label="历史对话列表" hidden>
  <div class="ai-history-header">
    <h2 class="ai-history-title">🕘 我的历史对话（保留最近 <%= typeof retentionDays === 'number' ? retentionDays : 30 %> 天）</h2>
    <div style="display:flex; gap:8px;">
      <button type="button" class="btn btn-secondary btn-sm" id="aiClearAllHistoryBtn">清空全部历史</button>
      <button type="button" class="btn btn-secondary btn-sm" id="aiHistoryCloseBtn">收起</button>
    </div>
  </div>
  <ul class="ai-history-list" id="aiHistoryList"></ul>
  <div class="ai-history-footer">
    🔒 历史对话按当前登录管理员账号独立隔离保存，仅您本人可见；超过 <%= typeof retentionDays === 'number' ? retentionDays : 30 %> 天的对话会自动清除。
  </div>
</section>

<div class="ai-chips-section">
  <span class="ai-chips-label" id="aiChipsLabel">💡 点击下方常见问题立即诊断：</span>
  <div class="ai-chips-wrap" id="aiChipsContainer"></div>
</div>

<div class="card ai-chat-card">
  <div class="ai-messages" id="aiMessages">
    <div class="ai-empty-state" id="aiEmptyState">
      <h2>选择一家门店或点击上方快捷问题开始诊断</h2>
      <p>
        助手会自动调用只读工具核查该门店的<strong>销售额环比、毛利、停拿品种、应收欠款</strong><% if (aiStatus.shelfguardEnabled) { %>，并同步拉取 <strong>ShelfGuard 巡检拜访次数、陈列评分与货架照片</strong><% } %>，先摆出真实数据卡片，再给出归因分析与核实建议。
      </p>
    </div>
  </div>
  <form class="ai-input-bar" id="aiChatForm">
    <textarea id="aiInput" rows="1" placeholder="输入你想了解的经营问题，例如：东门烟酒店最近为什么销量下滑？（Enter 发送，Shift+Enter 换行）"></textarea>
    <button type="submit" class="btn" id="aiSendBtn">发送诊断</button>
  </form>
</div>

<div class="ai-lightbox" id="aiLightbox" role="dialog" aria-label="巡检照片预览">
  <img id="aiLightboxImg" src="" alt="巡检照片大图" width="800" height="600">
</div>

<script id="aiAssistantConfig" type="application/json"><%- JSON.stringify({
  initialCustomerId: initialCustomerId || null,
  shelfguardEnabled: Boolean(aiStatus.shelfguardEnabled),
  sessions: Array.isArray(sessions) ? sessions : [],
  initialSession: initialSession || null
}).replace(/</g, '\\u003c') %></script>
<script src="/aiAssistant.js" defer></script>

<%- include('partials/footer') %>
