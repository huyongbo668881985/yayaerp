<%- include('partials/header') %>
<% const form = formValues || order || {}; const ordinary = !!linkedSale && (!order || order.workflow_version === 1); %>
<h1><%= order ? '编辑退货单 #' + order.id : '新建退货单' %></h1>
<div class="card">
  <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
  <p class="muted">先选择原销售单，再填写实际退货数量。审核确认收货后入库并抵原单欠款，现金退款另行登记。</p>
  <% if (!order || order.status === 'draft') { %>
  <div class="form-row">
    <label for="saleLookup">查找原销售单</label>
    <input id="saleLookup" type="search" placeholder="输入单号或客户名称" autocomplete="off">
    <div id="saleLookupResults" class="sale-lookup-results" hidden></div>
    <% if (linkedSale) { %><p>当前原单：<a href="/sales/<%= linkedSale.id %>">#<%= linkedSale.id %></a> · <%= linkedSale.order_date %></p><% } %>
    <% if (!order && currentUser.role === 'admin') { %><p><a href="/returns/new?exception=1">无原销售单：管理员例外办理</a></p><% } %>
  </div>
  <% } %>
  <% if (exceptionMode) { %><div class="flow-notice">例外退货需核实原凭证、客户、数量和价格，不会自动抵扣其他销售单。破损、过期货不能作为可售商品直接入库。</div><% } %>
  <form method="POST" action="<%= order ? '/returns/' + order.id + '/edit' : '/returns/new' %>" id="returnForm" data-order-draft="returns">
    <input type="hidden" name="_request_key" value="<%= form._request_key || newRequestKey() %>">
    <% if (order) { %><input type="hidden" name="draft_revision" value="<%= form.draft_revision != null ? form.draft_revision : order.revision %>"><% } %>
    <input type="hidden" name="related_sales_order_id" value="<%= linkedSale ? linkedSale.id : form.related_sales_order_id || '' %>">
    <h2 class="form-section-heading">基本信息</h2>
    <div class="grid-3">
      <div class="form-row">
        <label for="returnCustomer">客户<%= linkedSale ? '（沿用原单）' : '' %></label>
        <% if (linkedSale) { %><input type="hidden" name="customer_id" value="<%= linkedSale.customer_id || '' %>"><% } %>
        <select <%= linkedSale ? '' : 'name=customer_id' %> id="returnCustomer" <%= linkedSale ? 'disabled' : '' %>>
          <option value="">-- 散客 --</option>
          <% customers.forEach(function(c) { %><option value="<%= c.id %>" <%= String(linkedSale ? linkedSale.customer_id || '' : form.customer_id || '') === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div class="form-row">
        <label for="returnWarehouse">实际退回仓库 *</label>
        <select name="warehouse_id" id="returnWarehouse" required>
          <% warehouses.forEach(function(w) { %><option value="<%= w.id %>" <%= String(form.warehouse_id || '') === String(w.id) ? 'selected' : '' %>><%= w.name %></option><% }) %>
        </select>
      </div>
      <div class="form-row"><label for="returnDate">单据日期</label><input id="returnDate" type="date" name="order_date" value="<%= form.order_date || today %>"></div>
    </div>
    <% if (exceptionMode) { %><div class="form-row"><label for="exceptionReason">例外核实依据 *</label><textarea id="exceptionReason" name="exception_reason" rows="2" maxlength="500" required placeholder="原凭证、客户确认及数量价格核实情况"><%= form.exception_reason || '' %></textarea></div><% } %>
    <h2 class="form-section-heading">退货商品明细</h2>
    <% if (ordinary) { %><p class="muted">沿用原销售明细的单位、单价和成本。多张原单分开办理；拆箱或其他特殊退货交管理员核实。</p><% } %>
    <div id="items"></div>
    <% if (linkedSale || exceptionMode) { %><button type="button" class="btn btn-secondary btn-sm" onclick="addRow()">+ 添加一行</button><% } else { %><p>请先从上方查询结果选择原销售单。</p><% } %>
    <p><strong>退货合计：¥<span id="itemsTotal">0.00</span></strong></p>
    <h2 class="form-section-heading">原因与备注</h2>
    <div class="form-row"><label for="returnRemarks">备注</label><input id="returnRemarks" type="text" name="remarks" value="<%= form.remarks || '' %>" placeholder="客户确认等说明"></div>
    <div class="form-row"><label for="returnNote">内部备注 / 退货原因</label><textarea id="returnNote" name="note" rows="2"><%= form.note || '' %></textarea></div>
    <input type="hidden" name="refunded_amount" value="<%= order ? order.refunded_amount : 0 %>">
    <% if (order && order.refunded_amount > 0) { %><p>历史已录现金退款 ¥<%= order.refunded_amount.toFixed(2) %>，保持原记录。</p><% } %>
    <p class="muted">这里不登记实际退款。管理员审核收货后，按当前可退现金金额登记实际付款。</p>
    <input type="hidden" name="items_json" id="itemsJson">
    <div class="form-actions sale-form-actions">
      <button class="btn" type="submit" <%= linkedSale || exceptionMode ? '' : 'disabled' %>><%= order ? '保存修改' : '提交审核' %></button>
      <% if (!order) { %><button class="btn btn-secondary" type="submit" name="save_draft" value="1" <%= linkedSale || exceptionMode ? '' : 'disabled' %>>存草稿</button><% } %>
      <a class="btn btn-secondary" href="<%= order ? '/returns/' + order.id : '/returns' %>">取消</a>
    </div>
  </form>
</div>
<div class="sale-mobile-submit" aria-label="单据操作"><div><small>退货合计</small><strong>¥<span id="stickyItemsTotal">0.00</span></strong></div><% if (!order) { %><button class="btn btn-secondary" type="submit" form="returnForm" name="save_draft" value="1" <%= linkedSale || exceptionMode ? '' : 'disabled' %>>存草稿</button><% } %><button class="btn" type="submit" form="returnForm" <%= linkedSale || exceptionMode ? '' : 'disabled' %>><%= order ? '保存修改' : '提交审核' %></button></div>
<script>
  const ORDINARY = <%= ordinary ? 'true' : 'false' %>;
  window.returnSourceSaleId = <%= linkedSale ? linkedSale.id : 0 %>;
  const CAN_ADD = <%= linkedSale || exceptionMode ? 'true' : 'false' %>;
  const PRODUCTS = <%- JSON.stringify(products).replace(/</g, '\\u003c') %>;
  const ORIGINALS = <%- JSON.stringify(originalItems).replace(/</g, '\\u003c') %>;
  const EXISTING_ITEMS = <%- JSON.stringify(draftItems || existingItems.map(it => ({id:it.product_id,quantity:it.quantity,price:it.unit_price,original_sales_item_id:it.original_sales_item_id,unit_choice:it.base_quantity > it.quantity ? 'pack' : 'base'}))).replace(/</g, '\\u003c') %>;
  function esc(value) { return String(value == null ? '' : value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  const lookup = document.getElementById('saleLookup'), results = document.getElementById('saleLookupResults');
  let lookupVersion = 0;
  async function loadSales() {
    const version = ++lookupVersion;
    try {
      const response = await fetch('/returns/sales-options?q=' + encodeURIComponent(lookup.value.trim()));
      if (!response.ok) throw new Error('查询失败');
      const sales = await response.json(); if (version !== lookupVersion) return;
      results.replaceChildren();
      sales.forEach(sale => {
        const link = document.createElement('a'); link.className = 'sale-lookup-option';
        link.href = <%- JSON.stringify(order ? '/returns/' + order.id + '/edit?sale_id=' : '/returns/new?sale_id=') %> + sale.id;
        link.textContent = '#' + sale.id + ' · ' + (sale.customer_name || '散客') + ' · ' + sale.order_date + ' · ¥' + sale.total_amount.toFixed(2);
        results.appendChild(link);
      });
      if (!sales.length) results.textContent = '没有可关联的已审核销售单';
      results.hidden = false;
    } catch (_) { if (version === lookupVersion) { results.textContent = '查询失败，请稍后重试'; results.hidden = false; } }
  }
  lookup?.addEventListener('focus', loadSales); lookup?.addEventListener('input', loadSales);
  lookup?.addEventListener('keydown', event => { if (event.key === 'Enter') event.preventDefault(); });
  document.addEventListener('click', event => { if (lookup && !lookup.contains(event.target) && !results.contains(event.target)) results.hidden = true; });
  function syncOriginal(row, originalId) {
    const source = row.querySelector('[name=original_sales_item_id]');
    if (originalId) source.value = originalId;
    const original = ORIGINALS.find(item => item.id === Number(source.value));
    row.querySelector('[name=product_id]').value = original ? original.product_id : '';
    const unit = row.querySelector('[name=unit_choice]'); unit.replaceChildren();
    const option = document.createElement('option'); option.value = original && original.base_quantity > original.quantity ? 'pack' : 'base'; option.textContent = original ? original.unit_label : ''; unit.appendChild(option);
    row.querySelector('[name=unit_price]').value = original ? original.unit_price : '';
    const quantity = row.querySelector('[name=quantity]');
    if (original) quantity.max = Math.max(0, original.quantity - original.returned_quantity); else quantity.removeAttribute('max');
    recalcTotal();
  }
  window.restoreReturnRow = (row, item) => { if (ORDINARY) syncOriginal(row, item.original_sales_item_id); };
  function addRow(initial) {
    if (!CAN_ADD) return;
    const row = document.createElement('div'); row.className = 'item-row' + (ORDINARY ? ' return-source-row' : '');
    const products = PRODUCTS.map(p => `<option value="${p.id}" data-pack-size="${p.pack_size || 1}" data-name="${esc(p.name)}" data-search="${esc(p.name)}">${esc(p.name)}</option>`).join('');
    if (ORDINARY) {
      row.innerHTML = `<label>原销售明细<select name="original_sales_item_id" required aria-label="原销售明细"><option value="">-- 选择原明细 --</option>${ORIGINALS.map(item => `<option value="${item.id}">${esc(item.product_name)} · 明细 #${item.id} · ¥${item.unit_price.toFixed(2)}/${esc(item.unit_label)} · 原售 ${item.quantity}，已退 ${item.returned_quantity}</option>`).join('')}</select></label>
        <select name="product_id" hidden aria-hidden="true"><option value=""></option>${products}</select><select name="unit_choice" hidden aria-hidden="true"><option value="base"></option></select>
        <label>退货数量<input name="quantity" type="number" min="1" step="1" required aria-label="退货数量"></label>
        <label>原单价<input name="unit_price" type="number" step="0.01" readonly required aria-label="原单价"></label>
        <button type="button" class="btn btn-danger btn-sm">删除</button>`;
      row.querySelector('[name=original_sales_item_id]').addEventListener('change', () => { syncOriginal(row); row.dispatchEvent(new Event('order-form-change',{bubbles:true})); });
    } else {
      row.innerHTML = `<input type="search" class="product-search" aria-label="搜索商品"><select name="product_id" required onchange="onProductChange(this)"><option value="">-- 选择商品 --</option>${products}</select><select name="unit_choice" onchange="fillPrice(this.closest('.item-row').querySelector('[name=product_id]'))"></select><input name="quantity" type="number" min="1" step="1" required><input name="unit_price" type="number" min="0" step="0.01" required><button type="button" class="btn btn-danger btn-sm">删除</button>`;
    }
    row.querySelector('button').addEventListener('click', () => { row.remove(); recalcTotal(); });
    document.getElementById('items').appendChild(row);
    if (initial) {
      if (ORDINARY) {
        const candidates = ORIGINALS.filter(item => item.product_id === Number(initial.id) && (initial.unit_choice === 'pack' ? item.base_quantity > item.quantity : item.base_quantity === item.quantity));
        syncOriginal(row, initial.original_sales_item_id || (candidates.length === 1 ? candidates[0].id : null));
      } else {
        const select = row.querySelector('[name=product_id]'); select.value = initial.id; onProductChange(select);
        row.querySelector('[name=unit_choice]').value = initial.unit_choice;
        row.querySelector('[name=unit_price]').value = initial.price;
      }
      row.querySelector('[name=quantity]').value = initial.quantity;
    }
    recalcTotal();
  }
  function onProductChange(select) {
    if (ORDINARY) return;
    const product = PRODUCTS.find(item => item.id === Number(select.value));
    const unit = select.closest('.item-row').querySelector('[name=unit_choice]');
    unit.innerHTML = `<option value="base">${esc(product?.unit || '基本单位')}</option>` + (product?.pack_unit ? `<option value="pack">${esc(product.pack_unit)}</option>` : '');
    fillPrice(select);
  }
  function fillPrice(select) {
    const product = PRODUCTS.find(item => item.id === Number(select.value));
    if (!product) return;
    const row = select.closest('.item-row'), pack = row.querySelector('[name=unit_choice]').value === 'pack';
    row.querySelector('[name=unit_price]').value = pack ? product.sale_price_pack ?? product.sale_price * product.pack_size : product.sale_price;
  }
  function recalcTotal() {
    let total = 0; document.querySelectorAll('#items .item-row').forEach(row => { total += Number(row.querySelector('[name=quantity]').value || 0) * Number(row.querySelector('[name=unit_price]').value || 0); });
    for (const id of ['itemsTotal','stickyItemsTotal']) document.getElementById(id).textContent = Number.isFinite(total) ? total.toFixed(2) : '—';
  }
  document.getElementById('items').addEventListener('input', recalcTotal);
  document.getElementById('items').addEventListener('change', recalcTotal);
  if (EXISTING_ITEMS.length) EXISTING_ITEMS.forEach(addRow); else addRow();
  document.getElementById('returnForm').addEventListener('submit', function(event) {
    const items = Array.from(document.querySelectorAll('#items .item-row')).map(row => ({
      id: Number(row.querySelector('[name=product_id]').value), quantity: Number(row.querySelector('[name=quantity]').value),
      price: Number(row.querySelector('[name=unit_price]').value), unit_choice: row.querySelector('[name=unit_choice]').value,
      original_sales_item_id: row.querySelector('[name=original_sales_item_id]')?.value || null
    }));
    if (!items.length) { event.preventDefault(); return; }
    document.getElementById('itemsJson').value = JSON.stringify(items);
  });
</script>
<%- include('partials/footer') %>
